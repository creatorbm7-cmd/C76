 2 files changed, 27 insertions(+), 3 deletions(-)

diff --git a/src/lib/igaming.ts b/src/lib/igaming.ts
index d0e36b6..1685d49 100644
--- a/src/lib/igaming.ts
+++ b/src/lib/igaming.ts
@@ -46,6 +46,25 @@ export async function fetchLiveCatalog(): Promise<{ games: CatalogGame[]; config
   return { games: SEED, configured: SEED.length > 0, source: 'seed' };
 }
 
+/**
+ * fetchActiveAllowlist — reads the operator's activated-games allowlist from
+ * site_config (key `active_game_uids`, a JSON array of game uids). When present
+ * and non-empty, the user dashboard shows ONLY those games (e.g. the 73 titles
+ * activated on the aggregator). Absent/empty → show the full catalog. Read-only;
+ * no launch/money behavior is affected.
+ */
+export async function fetchActiveAllowlist(): Promise<Set<string> | null> {
+  try {
+    const { data } = await supabase.from('site_config').select('value').eq('key', 'active_game_uids').maybeSingle();
+    const v = (data as { value?: unknown } | null)?.value;
+    let arr: unknown = v;
+    if (typeof v === 'string') { try { arr = JSON.parse(v); } catch { arr = v.split(/[\s,]+/); } }
+    else if (v && typeof v === 'object' && Array.isArray((v as { uids?: unknown }).uids)) arr = (v as { uids: unknown[] }).uids;
+    if (Array.isArray(arr) && arr.length) return new Set(arr.map((x) => String(x)));
+  } catch { /* no allowlist → full catalog */ }
+  return null;
+}
