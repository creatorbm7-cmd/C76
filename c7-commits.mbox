diff --git a/supabase/migrations/20260820200000_c74_reward_simulation.sql b/supabase/migrations/20260820200000_c74_reward_simulation.sql
new file mode 100644
index 0000000..9efd4ed
--- /dev/null
+++ b/supabase/migrations/20260820200000_c74_reward_simulation.sql
@@ -0,0 +1,240 @@
+-- C74 reward — user-facing score breakdown + READ-ONLY reward simulation.
+--
+-- Two functions, both strictly read-only. They compute and DISPLAY numbers; they
+-- NEVER mint, emit, move money, change caps, or touch the reserve. This is the
+-- "validate before wiring" layer:
+--   * c74_my_contribution()          — the signed-in user sees how their own score
+--                                       is built (gameplay/loyalty/reputation/
+--                                       referrals/VIP). No reward promise.
+--   * admin_c74_reward_simulation()  — admin sees the full gating pipeline
+--                                       Score → Eligible → daily cap → lifetime cap
+--                                       → reserve check → SIMULATED emission, with
+--                                       the reserve-gate result. Emits nothing.
+--
+-- Guardrails restated: score ≠ guaranteed C74; deposits are an activity signal,
+-- never a backing; emission stays OFF (c74_earn_enabled) and caps are unchanged;
+-- redeemable emission is bounded by the reserve invariant. Wiring the multiplier
+-- into real emission remains a SEPARATE, reviewed step.
+
+begin;
+
+-- ── 1. User-facing: my own contribution breakdown ──
+create or replace function public.c74_my_contribution()
+returns jsonb
+language plpgsql
+stable
+security definer
+set search_path = public
+as $$
+declare
+  uid uuid := auth.uid();
+  b   record;
+begin
+  if uid is null then raise exception 'Not authenticated'; end if;
+
+  select
+    coalesce(ue.energy_points,0) as energy,
+    coalesce(cw.wagered,0)       as wagered,
+    coalesce(cw.deposited,0)     as deposited,
+    coalesce(cw.quar,false)      as quarantine,
+    coalesce(m.streak_days,0)    as streak,
+    greatest(0, floor(extract(epoch from (now()-p.created_at))/86400)::int) as age_days,
+    coalesce(p.email_verified,false) as email_ver,
+    coalesce(p.two_factor_enabled,false) as tfa,
+    kyc.status as kyc_status,
+    coalesce(ref.cnt,0) as referrals
+  into b
+  from profiles p
+  left join user_energy ue on ue.user_id=p.id
+  left join (select user_id, sum(total_wagered) wagered, sum(total_deposited) deposited, bool_or(quarantine) quar
+             from casino_wallets group by user_id) cw on cw.user_id=p.id
+  left join c74_mining m on m.user_id=p.id
+  left join lateral (select status from kyc_submissions k where k.user_id=p.id
+                     order by submitted_at desc nulls last limit 1) kyc on true
+  left join (select referred_by, count(*) cnt from profiles where referred_by is not null group by referred_by) ref
+         on ref.referred_by=p.id
+  where p.id = uid;
+
+  if b is null then
+    return jsonb_build_object('score',0,'eligible',false,'breakdown','[]'::jsonb);
+  end if;
+
+  return (
+    with s as (
+      select
+        case when b.wagered>=10000 then 4 when b.wagered>=5000 then 3 when b.wagered>=1000 then 2
+             when b.wagered>=100 then 1 else 0 end as vip_idx,
+        least(least(b.age_days,200)
+          + case when b.kyc_status='approved' then 200 else 0 end
+          + least(round(b.wagered/50.0)::int,200)
+          + least(round(b.deposited/33.0)::int,150)
+          + least(b.streak,10)*10
+          + (case when b.email_ver then 25 else 0 end)+(case when b.tfa then 25 else 0 end)
+          + case when b.quarantine then 0 else 100 end, 1000) as reputation
+    )
+    select jsonb_build_object(
+      'score', round(b.energy*1.0 + s.reputation*10.0 + b.wagered*5.0 + b.referrals*50.0 + s.vip_idx*100.0, 1),
+      'tier', case s.vip_idx when 4 then 'Diamond' when 3 then 'Platinum' when 2 then 'Gold'
+                             when 1 then 'Silver' else 'Bronze' end,
+      'multiplier', case s.vip_idx when 4 then 2.00 when 3 then 1.50 when 2 then 1.25 when 1 then 1.10 else 1.00 end,
+      'eligible', (not b.quarantine and (b.energy>0 or b.wagered>0 or s.reputation>=100 or b.age_days>=1)),
+      'breakdown', jsonb_build_array(
+        jsonb_build_object('label','Gameplay (wager)','raw',round(b.wagered,2),'weight',5,  'points',round(b.wagered*5.0,1)),
+        jsonb_build_object('label','Loyalty (energy)','raw',round(b.energy,2), 'weight',1,  'points',round(b.energy*1.0,1)),
+        jsonb_build_object('label','Reputation',      'raw',s.reputation,      'weight',10, 'points',round(s.reputation*10.0,1)),
+        jsonb_build_object('label','Referrals',       'raw',b.referrals,       'weight',50, 'points',round(b.referrals*50.0,1)),
+        jsonb_build_object('label','VIP',             'raw',s.vip_idx,         'weight',100,'points',round(s.vip_idx*100.0,1))
+      ),
+      'note', 'Your score reflects genuine activity. It is NOT a guaranteed reward — actual C74 depends on availability, daily/lifetime caps and the backing reserve.'
+    )
+    from s
+  );
+end;
+$$;
+revoke all on function public.c74_my_contribution() from public;
+grant execute on function public.c74_my_contribution() to authenticated;
+
+-- ── 2. Admin: read-only reward simulation (emits nothing) ──
+--    p_daily_pool is a SIMULATION assumption (a hypothetical daily reward budget),
+--    NOT a stored cap. It only shapes the preview; nothing is persisted.
+create or replace function public.admin_c74_reward_simulation(
+  p_limit int default 50,
+  p_daily_pool numeric default 10000
+)
+returns jsonb
+language plpgsql
+stable
+security definer
+set search_path = public
+as $$
+declare
+  v_limit int := least(greatest(coalesce(p_limit,50),1),500);
+  v_pool  numeric := greatest(coalesce(p_daily_pool,0),0);
+begin
+  if auth.uid() is null or not public.has_role(auth.uid(),'admin') then raise exception 'Forbidden'; end if;
+
+  return (
+  with cfg as (
+    select
+      lower(coalesce((select value from platform_settings where key='c74_earn_enabled'),'false'))='true' as earn_enabled,
+      coalesce((select nullif(value,'')::numeric from platform_settings where key='c74_reward_daily_cap_per_user'), 100)     as per_day_cap,
+      coalesce((select nullif(value,'')::numeric from platform_settings where key='c74_reward_lifetime_cap_per_user'), 2000) as per_life_cap,
+      coalesce((select nullif(value,'')::numeric from platform_settings where key='c74_daily_emission_cap'), 500000)         as g_daily_cap,
+      coalesce((select sum(delta) filter (where delta>0 and created_at>=date_trunc('day',now())) from energy_ledger),0)      as g_daily_used
+  ),
+  cfg2 as (select *, greatest(g_daily_cap - g_daily_used, 0) as g_daily_rem from cfg),
+  res as (
+    select invariant_ok as inv_ok, reserve_usdt, redeemable_liability_usdt as redeem_liab, peg_rate as peg,
+      case when coalesce(peg_rate,0)>0 then greatest((reserve_usdt - redeemable_liability_usdt)/peg_rate,0) else 0 end as headroom_c74
+    from c74_reserve_status
+  ),
+  base as (
+    select p.id as user_id,
+      greatest(0, floor(extract(epoch from (now()-p.created_at))/86400)::int) as age_days,
+      coalesce(p.email_verified,false) as email_ver, coalesce(p.two_factor_enabled,false) as tfa,
+      coalesce(ue.energy_points,0) as energy, coalesce(cw.wagered,0) as wagered,
+      coalesce(cw.deposited,0) as deposited, coalesce(cw.quar,false) as quarantine,
+      coalesce(m.streak_days,0) as streak, kyc.status as kyc_status, coalesce(ref.cnt,0) as referrals
+    from profiles p
+    left join user_energy ue on ue.user_id=p.id
+    left join (select user_id, sum(total_wagered) wagered, sum(total_deposited) deposited, bool_or(quarantine) quar
+               from casino_wallets group by user_id) cw on cw.user_id=p.id
+    left join c74_mining m on m.user_id=p.id
+    left join lateral (select status from kyc_submissions k where k.user_id=p.id order by submitted_at desc nulls last limit 1) kyc on true
+    left join (select referred_by, count(*) cnt from profiles where referred_by is not null group by referred_by) ref on ref.referred_by=p.id
+  ),
+  scored as (
+    select *,
+      case when wagered>=10000 then 4 when wagered>=5000 then 3 when wagered>=1000 then 2 when wagered>=100 then 1 else 0 end as vip_idx,
+      least(least(age_days,200) + case when kyc_status='approved' then 200 else 0 end
+        + least(round(wagered/50.0)::int,200) + least(round(deposited/33.0)::int,150)
+        + least(streak,10)*10 + (case when email_ver then 25 else 0 end)+(case when tfa then 25 else 0 end)
+        + case when quarantine then 0 else 100 end, 1000) as reputation
+    from base
+  ),
+  elig as (
+    select user_id,
+      (not quarantine and (energy>0 or wagered>0 or reputation>=100 or age_days>=1)) as eligible,
+      (energy*1.0 + reputation*10.0 + wagered*5.0 + referrals*50.0 + vip_idx*100.0) as score,
+      case vip_idx when 4 then 2.00 when 3 then 1.50 when 2 then 1.25 when 1 then 1.10 else 1.00 end as multiplier
+    from scored
+  ),
+  em as (
+    select user_id,
+      coalesce(sum(delta) filter (where delta>0),0) as life_emitted,
+      coalesce(sum(delta) filter (where delta>0 and created_at>=date_trunc('day',now())),0) as day_emitted
+    from energy_ledger group by user_id
+  ),
+  pipe0 as (
+    select e.user_id, e.score, e.multiplier,
+      coalesce(m.day_emitted,0) as day_emitted, coalesce(m.life_emitted,0) as life_emitted,
+      sum(e.score) over () as total_score
+    from elig e left join em m on m.user_id=e.user_id
+    where e.eligible
+  ),
+  pipe as (
+    select p0.*,
+      (case when total_score>0 then v_pool * (score/total_score) * multiplier else 0 end) as raw_eligible,
+      greatest(least(
+        (case when total_score>0 then v_pool * (score/total_score) * multiplier else 0 end),
+        greatest(c.per_day_cap - day_emitted,0)),0) as after_daily
+    from pipe0 p0 cross join cfg2 c
+  ),
+  pipe2 as (
+    select p.*,
+      greatest(least(after_daily, greatest(c.per_life_cap - life_emitted,0)),0) as after_lifetime
+    from pipe p cross join cfg2 c
+  ),
+  agg as (select coalesce(sum(after_lifetime),0) as sum_after, count(*) as n from pipe2),
+  gate as (
+    select
+      least(c.g_daily_rem, r.headroom_c74) as gate_ceiling,
+      case
+        when not r.inv_ok      then 0
+        when not c.earn_enabled then 0
+        else least(a.sum_after, least(c.g_daily_rem, r.headroom_c74))
+      end as final_total,
+      case
+        when not r.inv_ok       then 'reserve_invariant_broken'
+        when not c.earn_enabled then 'earn_disabled'
+        when least(a.sum_after, least(c.g_daily_rem, r.headroom_c74)) >= a.sum_after then 'within_limits'
+        when r.headroom_c74 <= c.g_daily_rem then 'reserve_headroom'
+        else 'global_daily_cap'
+      end as binding
+    from cfg2 c, res r, agg a
+  ),
+  scaled as (select case when a.sum_after>0 then g.final_total/a.sum_after else 0 end as scale from agg a, gate g)
+  select jsonb_build_object(
+    'generated_at', now(),
+    'assumptions', jsonb_build_object(
+      'daily_reward_pool_sim', v_pool,
+      'note', 'daily_reward_pool_sim is a hypothetical budget for this preview only — NOT a stored cap.'),
+    'config', (select jsonb_build_object(
+      'earn_enabled', earn_enabled, 'per_user_daily_cap', per_day_cap, 'per_user_lifetime_cap', per_life_cap,
+      'global_daily_cap', g_daily_cap, 'global_daily_used', round(g_daily_used,2), 'global_daily_remaining', round(g_daily_rem,2)) from cfg2),
+    'reserve', (select jsonb_build_object(
+      'invariant_ok', inv_ok, 'reserve_usdt', round(reserve_usdt,4), 'redeemable_liability_usdt', round(redeem_liab,4),
+      'peg_rate', peg, 'headroom_c74', round(headroom_c74,2)) from res),
+    'result', (select jsonb_build_object(
+      'eligible_users', a.n, 'total_raw_after_caps', round(a.sum_after,2),
+      'gate_ceiling_c74', round(g.gate_ceiling,2), 'simulated_total_emission', round(g.final_total,2),
+      'binding_gate', g.binding, 'emits_anything', (g.final_total>0)) from agg a, gate g),
+    'top', coalesce((
+      select jsonb_agg(to_jsonb(t) order by t.after_lifetime desc, t.score desc)
+      from (
+        select user_id, round(score,1) as score, multiplier,
+          round(raw_eligible,2) as raw_eligible, round(after_daily,2) as after_daily,
+          round(after_lifetime,2) as after_lifetime,
+          round(after_lifetime * (select scale from scaled),2) as simulated_emission,
+          round(day_emitted,2) as day_emitted, round(life_emitted,2) as life_emitted
+        from pipe2 order by after_lifetime desc, score desc limit v_limit
+      ) t), '[]'::jsonb),
+    'contract', 'SIMULATION ONLY — nothing is emitted, no caps changed, no money moved. Emission stays OFF until wired in a separate reviewed step.'
+  )
+  );
+end;
+$$;
+revoke all on function public.admin_c74_reward_simulation(int,numeric) from public;
+grant execute on function public.admin_c74_reward_simulation(int,numeric) to authenticated;
+
+commit;
-- 
