From ab0d75698ff7b767fb7dee8772b4e244048c8f24 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 21 Aug 2026 03:42:33 +0000
Subject: [PATCH 018/137] Fix blank-screen on stale service worker: boot
 watchdog in index.html
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Root cause: when a stale SW served a cached shell pointing at chunk hashes a
newer deploy removed, the JS entry bundle 404'd and never executed. main.tsx's
own chunk-error self-heal lives INSIDE that bundle, so nothing recovered it —
users saw the static green shell with an empty #root (private tab worked, which
confirmed it was SW/cache state, not Vercel).

Fix: an inline watchdog in index.html (always runs, even when the bundle fails).
If #root is still empty after an 8s grace, it purges the SW + caches and hard-
reloads ONCE (sessionStorage-guarded against loops; guard clears once the app
mounts so future incidents can self-heal). Also relabel sw.js CACHE_VERSION
(build still stamps a unique value via stamp-sw). Presentation/robustness only.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Xfrv5JAUtWCznLv4SCRSds
---
 index.html   | 47 +++++++++++++++++++++++++++++++++++++++++++++++
 public/sw.js |  2 +-
 2 files changed, 48 insertions(+), 1 deletion(-)

diff --git a/index.html b/index.html
index 439f0e0..f22d8ad 100644
--- a/index.html
+++ b/index.html
@@ -96,6 +96,53 @@
   <body>
     <div id="root"></div>
     <script type="module" src="/src/main.tsx"></script>
+    <script>
+      // Boot watchdog — recovers a blank screen when the JS bundle itself fails to
+      // load/execute (e.g. a stale service worker serving a cached index that points
+      // at chunk hashes a newer deploy removed). In that case main.tsx never runs, so
+      // its own chunk-error self-heal never registers — this inline script always
+      // runs and is the only thing that can recover. If #root is still empty after a
+      // grace period, purge the SW + caches and hard-reload ONCE (sessionStorage-
+      // guarded so a genuinely-down origin can't cause a reload loop). Clears the
+      // guard once the app mounts, so a future incident can self-heal again.
+      (function () {
+        var KEY = '__c7_boot_recover__';
+        var GRACE_MS = 8000;
+        function mounted() {
+          var r = document.getElementById('root');
+          return !!(r && r.childElementCount > 0);
+        }
+        function clearGuard() { try { sessionStorage.removeItem(KEY); } catch (e) {} }
+        // Once the app has mounted, drop the guard so later incidents can recover.
+        window.addEventListener('load', function () {
+          setTimeout(function () { if (mounted()) clearGuard(); }, GRACE_MS + 2000);
+        });
+        setTimeout(function () {
+          if (mounted()) { clearGuard(); return; }
+          var already = null;
+          try { already = sessionStorage.getItem(KEY); } catch (e) {}
+          if (already) return;                       // already tried once — never loop
+          try { sessionStorage.setItem(KEY, '1'); } catch (e) {}
+          var done = false;
+          function reloadOnce() { if (done) return; done = true; window.location.reload(); }
+          var tasks = [];
+          try {
+            if ('serviceWorker' in navigator) {
+              tasks.push(navigator.serviceWorker.getRegistrations()
+                .then(function (rs) { return Promise.all(rs.map(function (r) { return r.unregister(); })); })
+                .catch(function () {}));
+            }
+            if (typeof caches !== 'undefined') {
+              tasks.push(caches.keys()
+                .then(function (ks) { return Promise.all(ks.map(function (k) { return caches.delete(k); })); })
+                .catch(function () {}));
+            }
+          } catch (e) {}
+          Promise.all(tasks).then(reloadOnce).catch(reloadOnce);
+          setTimeout(reloadOnce, 1500);              // backstop if cleanup hangs
+        }, GRACE_MS);
+      })();
+    </script>
     <script>
       // Register C7Winner service worker (PWA) — gracefully no-op if unsupported.
       // The SW itself skipWaiting()s on install and clients.claim()s on activate,
