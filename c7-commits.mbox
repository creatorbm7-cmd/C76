From 1e6e9100a0840677fdc631d1d5ab8df94a87fd5a Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 20 Aug 2026 21:35:08 +0000
Subject: [PATCH 004/137] deposit-watcher-tron: skip deposit_monitors writes on
 empty polls

Empty-poll disk-I/O reduction (read-only-recommended fix from the watcher audit).
No schedule change, no correctness/finality/settlement change.

TRON was the only one of the three watchers writing on an empty poll: two
UPDATEs to the 1-row deposit_monitors table every run (start: is_running=true +
last_run_at; end: is_running=false + last_run_at + error_count), causing constant
dead-tuple/WAL/autovacuum churn (623 autovacuums observed on a 1-row table).

- Remove the start-of-run write: is_running was set but never read as a lock.
- Gate the end-of-run cursor write on (inserted > 0 || errors > 0): skip it on an
  empty poll. Safe because minTs is pinned to now-LOOKBACK_MS regardless of
  last_run_at, so not advancing the cursor never changes which txs are scanned or
  credited. BTC/TON already write nothing on empty polls; unchanged.

Removes ~1,440 deposit_monitors writes/day at zero added latency.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Xfrv5JAUtWCznLv4SCRSds
---
 .../functions/deposit-watcher-tron/index.ts    | 18 ++++++++++++++----
 1 file changed, 14 insertions(+), 4 deletions(-)

diff --git a/supabase/functions/deposit-watcher-tron/index.ts b/supabase/functions/deposit-watcher-tron/index.ts
index 1030ede..1d65b72 100644
--- a/supabase/functions/deposit-watcher-tron/index.ts
+++ b/supabase/functions/deposit-watcher-tron/index.ts
@@ -144,9 +144,13 @@ Deno.serve(async (req) => {
       .from("deposit_monitors").select("id, last_run_at").eq("chain", "TRC20").maybeSingle();
     const lastRun = mon?.last_run_at ? new Date(mon.last_run_at).getTime() : 0;
     const minTs = Math.max(lastRun - LOOKBACK_MS, Date.now() - LOOKBACK_MS);
-    if (mon?.id) {
-      await sb.from("deposit_monitors").update({ is_running: true, last_run_at: new Date().toISOString() }).eq("id", mon.id);
-    }
+    // NOTE: the previous start-of-run write (is_running=true, last_run_at=now())
+    // was removed. `is_running` was set but never read as a lock, and `last_run_at`
+    // is NOT load-bearing for the scan window — `minTs` is pinned to
+    // `Date.now() - LOOKBACK_MS` regardless of it (the `lastRun - LOOKBACK_MS` term
+    // is always the smaller one). Writing this 1-row table on every poll only
+    // churned dead tuples / WAL / autovacuum. The cursor is now persisted once, at
+    // the end of the run, and only when the poll actually did work (see below).
 
     const now = Date.now();
     let detected = 0, inserted = 0, errors = 0;
@@ -200,7 +204,13 @@ Deno.serve(async (req) => {
       credited = typeof c === "number" ? c : 0;
     }
 
-    if (mon?.id) {
+    // Persist the cursor ONLY when the poll did real work (a deposit was inserted
+    // or a fetch error occurred). On an empty poll we skip the write entirely —
+    // safe because `minTs` does not depend on `last_run_at`, so not advancing it
+    // never changes which transactions get scanned or credited. This removes the
+    // per-poll heartbeat churn on `deposit_monitors` (the watcher's dominant
+    // empty-poll disk I/O) with no effect on deposit correctness or finality.
+    if (mon?.id && (inserted > 0 || errors > 0)) {
       await sb.from("deposit_monitors")
         .update({ is_running: false, last_run_at: new Date().toISOString(), error_count: errors })
         .eq("id", mon.id);
