diff --git a/supabase/migrations/20260821060000_withdrawal_gate_eval.sql b/supabase/migrations/20260821060000_withdrawal_gate_eval.sql
new file mode 100644
index 0000000..24dcc20
--- /dev/null
+++ b/supabase/migrations/20260821060000_withdrawal_gate_eval.sql
@@ -0,0 +1,143 @@
+-- Withdrawal L4 gate evaluation — READ-ONLY.
+--
+-- For each recent withdrawal it evaluates the L4 gate (from the real-money flow
+-- design) on REAL data and returns a per-gate result + an overall verdict:
+--   PASS  — every gate clears
+--   HOLD  — a soft gate flags manual review (large amount, cooling period)
+--   BLOCK — a hard gate fails (no provenance, exceeds balance, wagering unmet,
+--           KYC not approved, quarantined)
+--
+-- HARD GUARANTEES:
+--   * Read-only. SELECT-only; approves nothing, sends nothing, moves nothing.
+--   * A full PASS still does NOT pay out: real payout stays OFF until
+--     real_money_enabled AND auto_payout_enabled are both on (both currently off).
+--     The verdict is advisory classification, never an instruction to send.
+--   * Grounded in real signals only; no fabricated approvals.
+--
+-- Gates evaluated per request:
+--   provenance     destination present            (missing → BLOCK)
+--   amount         amount > 0                      (→ BLOCK)
+--   balance        amount ≤ wallet balance         (available-liability gate → BLOCK)
+--   wagering       total_wagered ≥ total_deposited (deposit/wager requirement → BLOCK)
+--   kyc            latest KYC = approved           (→ BLOCK)
+--   risk_aml       not quarantined; amount ≤ review threshold (quarantine→BLOCK, over→HOLD)
+--   cooling_period account age ≥ 1 day             (→ HOLD)
+
+begin;
+
+create or replace function public.admin_withdrawal_gate_eval(p_limit int default 50)
+returns jsonb
+language plpgsql
+stable
+security definer
+set search_path = public
+as $$
+declare
+  v_rows      jsonb;
+  v_limit     int := least(greatest(coalesce(p_limit,50),1), 200);
+  v_threshold numeric := coalesce((select nullif(value,'')::numeric from platform_settings where key='withdrawal_auto_approve_threshold'), 100);
+  v_cooling   int := 1;   -- days
+  v_payout_on boolean := coalesce((select value='true' from platform_settings where key='real_money_enabled'),false)
+                     and coalesce((select value='true' from platform_settings where key='auto_payout_enabled'),false);
+begin
+  if auth.uid() is null or not public.has_role(auth.uid(), 'admin') then
+    raise exception 'Forbidden';
+  end if;
+
+  with wd as (
+    select 'crypto_withdrawals' as rail, id, user_id, amount, coalesce(net_amount,amount) net_amount,
+           coalesce(fee,0) fee, currency, coalesce(chain,'—') chain, to_address as destination,
+           status, created_at
+    from crypto_withdrawals
+    union all
+    select 'withdrawal_requests', id, user_id, amount, coalesce(net_amount,amount),
+           coalesce(fee,0), currency, coalesce(chain,'—'), wallet_address,
+           status, created_at
+    from withdrawal_requests
+  ),
+  recent as (select * from wd order by created_at desc limit v_limit),
+  enriched as (
+    select r.*,
+      cw.balance, cw.total_deposited, cw.total_wagered, coalesce(cw.quarantine,false) quarantine,
+      kyc.status as kyc_status,
+      greatest(0, floor(extract(epoch from (now()-p.created_at))/86400)::int) as age_days,
+      (coalesce(r.status,'') ~* '(reject|refund|complete|sent|paid|fail|cancel|done)') as is_terminal
+    from recent r
+    left join casino_wallets cw on cw.user_id=r.user_id and cw.currency=r.currency
+    left join profiles p on p.id=r.user_id
+    left join lateral (select status from kyc_submissions k where k.user_id=r.user_id
+                       order by submitted_at desc nulls last limit 1) kyc on true
+  ),
+  graded as (
+    select e.*,
+      case when destination is null or btrim(destination)='' then 'block' else 'pass' end as g_prov,
+      case when amount > 0 then 'pass' else 'block' end as g_amt,
+      case when balance is null then 'block' when amount <= balance then 'pass' else 'block' end as g_bal,
+      case when coalesce(total_deposited,0) <= coalesce(total_wagered,0) then 'pass' else 'block' end as g_wager,
+      case when kyc_status='approved' then 'pass' else 'block' end as g_kyc,
+      case when quarantine then 'block' when amount > v_threshold then 'hold' else 'pass' end as g_risk,
+      case when age_days >= v_cooling then 'pass' else 'hold' end as g_cool
+    from enriched e
+  ),
+  verdicts as (
+    select g.*,
+      case when 'block' in (g_prov,g_amt,g_bal,g_wager,g_kyc,g_risk,g_cool) then 'BLOCK'
+           when 'hold'  in (g_prov,g_amt,g_bal,g_wager,g_kyc,g_risk,g_cool) then 'HOLD'
+           else 'PASS' end as verdict
+    from graded g
+  )
+  select coalesce(jsonb_agg(jsonb_build_object(
+    'rail', rail, 'id', id, 'user_short', substr(user_id::text,1,8),
+    'amount', round(amount,4), 'net_amount', round(net_amount,4), 'fee', round(fee,4),
+    'currency', coalesce(currency,'—'), 'chain', chain,
+    'destination', case when destination is null then null
+                        when length(destination) <= 16 then destination
+                        else left(destination,8)||'…'||right(destination,6) end,
+    'db_status', status, 'is_terminal', is_terminal, 'created_at', created_at,
+    'verdict', verdict,
+    'payout_enabled', v_payout_on,
+    'effective_action', case when verdict='PASS' and not v_payout_on then 'PASS · payout OFF — not sent' else verdict end,
+    'gates', jsonb_build_array(
+      jsonb_build_object('key','provenance','label','Destination provenance', 'result',g_prov,
+        'detail', case when g_prov='block' then 'no destination on the request' else coalesce(destination,'') end),
+      jsonb_build_object('key','amount','label','Amount positive','result',g_amt,
+        'detail', case when g_amt='block' then 'amount is not > 0' else '$'||round(amount,2) end),
+      jsonb_build_object('key','balance','label','Available balance','result',g_bal,
+        'detail', case when balance is null then 'no wallet for this currency'
+                       when g_bal='block' then 'amount > balance ($'||round(coalesce(balance,0),2)||')'
+                       else '≤ balance ($'||round(balance,2)||')' end),
+      jsonb_build_object('key','wagering','label','Deposit / wager requirement','result',g_wager,
+        'detail', 'wagered $'||round(coalesce(total_wagered,0),2)||' vs deposited $'||round(coalesce(total_deposited,0),2)),
+      jsonb_build_object('key','kyc','label','KYC / verification','result',g_kyc,
+        'detail', 'kyc: '||coalesce(kyc_status,'none')),
+      jsonb_build_object('key','risk_aml','label','Risk / AML','result',g_risk,
+        'detail', case when quarantine then 'wallet quarantined'
+                       when g_risk='hold' then 'amount > review threshold ($'||round(v_threshold,2)||')'
+                       else 'no risk flags' end),
+      jsonb_build_object('key','cooling_period','label','Cooling period','result',g_cool,
+        'detail', 'account age '||age_days||'d (min '||v_cooling||'d)')
+    )
+  ) order by (case verdict when 'BLOCK' then 0 when 'HOLD' then 1 else 2 end), created_at desc), '[]'::jsonb)
+  into v_rows
+  from verdicts;
+
+  return jsonb_build_object(
+    'generated_at', now(),
+    'contract', 'Read-only L4 gate evaluation. Classifies each withdrawal PASS/HOLD/BLOCK from real signals; it approves nothing and sends nothing. A PASS still does not pay out — real payout stays OFF until real_money_enabled AND auto_payout_enabled are both on.',
+    'payout_enabled', v_payout_on,
+    'review_threshold', round(v_threshold,2),
+    'cooling_days', v_cooling,
+    'counts', jsonb_build_object(
+      'total', jsonb_array_length(v_rows),
+      'block', (select count(*) from jsonb_array_elements(v_rows) e where e->>'verdict'='BLOCK'),
+      'hold',  (select count(*) from jsonb_array_elements(v_rows) e where e->>'verdict'='HOLD'),
+      'pass',  (select count(*) from jsonb_array_elements(v_rows) e where e->>'verdict'='PASS')),
+    'rows', v_rows
+  );
+end;
+$$;
+
+revoke all on function public.admin_withdrawal_gate_eval(int) from public;
+grant execute on function public.admin_withdrawal_gate_eval(int) to authenticated;
+
+commit;
-- 
