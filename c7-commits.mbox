From 330d1269dc90901570fb329ac38f0fd6b59c7470 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 26 Aug 2026 10:18:21 +0000
Subject: [PATCH 107/137] =?UTF-8?q?ig(style):=20RICH=20SWEEP=20v2=20?=
 =?UTF-8?q?=E2=80=94=20glamour=20lift=20(all=20/ig=20pages)?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Additive luxury pass on top of v1, shared via ig-premium.css (app-wide):
- .ig-top gold-glass: deeper tri-stop ground, brighter under-bloom, crisp
  gold top hairline
- .ig-ttl soft gold bloom under the shimmer (drop-shadow, no new motion)
- .ig-main::before faint gold 'spotlight from above' horizon on every page
- glossier gold scrollbar thumb; warmer gold selection
- .ig-rich helper more jewel-like (deeper emerald core, softer gold halo)

Static (no added animation), collision-safe, reduced-motion unaffected.
Presentation only — no layout/routes/data/hooks/logic touched.
real_money_enabled OFF; production untouched.
---
 src/styles/ig-premium.css | 54 +++++++++++++++++++++++++++++++++++++++
 1 file changed, 54 insertions(+)

diff --git a/src/styles/ig-premium.css b/src/styles/ig-premium.css
index 1fcc330..1be51bf 100644
--- a/src/styles/ig-premium.css
+++ b/src/styles/ig-premium.css
@@ -510,3 +510,57 @@
   .ig .ig-ttl { animation: none !important; background-position: 0 50% !important; }
   .ig .ig-main { animation: none !important; }
 }
+
+/* ===================================================================
+   RICH SWEEP v2 — GLAMOUR. A measured luxury lift on top of v1, shared
+   by every .ig page. Static (no new motion — the v1 title shimmer is the
+   only movement), additive, collision-safe. Presentation only. */
+
+/* Top bar → gold-glass: deeper tri-stop ground, brighter under-bloom, and
+   a crisp gold top hairline. (Refines the v1 .ig-top treatment.) */
+.ig-top {
+  background-image:
+    linear-gradient(180deg, rgba(13,45,29,0.5), rgba(9,32,20,0) 70%),
+    linear-gradient(180deg, rgba(9,32,20,0.92), rgba(9,32,20,0.6)) !important;
+  box-shadow:
+    0 1px 0 rgba(240,201,74,0.34),
+    0 6px 20px -10px rgba(240,201,74,0.28),
+    0 14px 34px -22px rgba(0,0,0,0.8);
+}
+
+/* Page titles → soft gold bloom under the shimmer (drop-shadow, not a new
+   animation — keeps it glamorous but calm). */
+.ig .ig-ttl { filter: drop-shadow(0 1px 6px rgba(240,201,74,0.34)); }
+
+/* Every page body gets a faint gold horizon at the very top — a subtle
+   "spotlight from above" that reads as premium. Non-interactive, static. */
+.ig .ig-main { position: relative; }
+.ig .ig-main::before {
+  content: ""; position: absolute; left: 50%; top: -10px; transform: translateX(-50%);
+  width: 150%; height: 190px; pointer-events: none; z-index: 0;
+  background: radial-gradient(60% 100% at 50% 0%, rgba(240,201,74,0.10), rgba(46,224,138,0.05) 42%, transparent 72%);
+}
+.ig .ig-main > * { position: relative; z-index: 1; }
+
+/* Glossier gold scrollbar thumb */
+.ig *::-webkit-scrollbar-thumb {
+  background: linear-gradient(180deg, #fff4cf, #f0c94a 42%, #c68a2e);
+  box-shadow: inset 0 1px 0 rgba(255,255,255,0.5);
+}
+
+/* .ig-rich helper → a touch more jewel-like (deeper emerald core, warmer
+   gold frame, softer outer gold halo). */
+.ig .ig-rich {
+  background:
+    radial-gradient(120% 90% at 50% -14%, rgba(58,240,160,0.16), transparent 58%),
+    linear-gradient(180deg, rgba(24,86,55,0.96), rgba(7,28,18,0.96));
+  box-shadow:
+    inset 0 0 0 1.4px rgba(240,201,74,0.5),
+    inset 0 1.6px 0 rgba(255,246,213,0.3),
+    inset 0 30px 50px -34px rgba(58,240,160,0.34),
+    0 0 30px -12px rgba(240,201,74,0.5),
+    0 24px 52px -26px rgba(0,0,0,0.88);
+}
+
+/* Selection: warmer gold */
+.ig ::selection { background: rgba(240,201,74,0.34); color: #06180f; }
