@@ -0,0 +1,125 @@
+-- ─────────────────────────────────────────────────────────────────────────
+-- DRAFT — NOT APPLIED. Defense-in-depth master gate for the C74 → USDT swap.
+--
+-- WHY: `redeem_c74_to_usdt` credits a WITHDRAWABLE USDT balance
+-- (profiles.balance + casino_wallets.balance) and draws the operator swap pool.
+-- It is therefore a money-OUT path, but today it is gated ONLY by
+-- `c74_swap_settings.enabled` and does NOT pass through `apply_ledger_entry`
+-- (where the `is_real_money_enabled()` master gate lives). This makes the swap a
+-- coin→cash path that stays open even while real money is OFF.
+--
+-- WHAT THIS DOES: reproduces `redeem_c74_to_usdt` VERBATIM from
+-- `20260814210000_c74_usdt_safe_swap.sql` and adds ONE fail-closed guard at the
+-- very top — the redemption is rejected when `public.is_real_money_enabled()` is
+-- false, INDEPENDENT of `c74_swap_settings.enabled`. All existing accounting,
+-- caps, idempotency, serialization and grants are preserved unchanged.
+--
+-- WHAT THIS DOES NOT DO:
+--   • does NOT enable the swap (c74_swap_settings.enabled is untouched)
+--   • does NOT change real_money_enabled
+--   • does NOT modify production data
+--   • is NOT applied / deployed by this branch — it is a reviewed draft only
+--
+-- DEPENDENCY: requires `public.is_real_money_enabled()` from
+-- `20260822120000_real_money_master_gate.sql` (also a branch draft). Apply both
+-- together in the authorized change window; never in isolation.
+-- ─────────────────────────────────────────────────────────────────────────
+
+create or replace function public.redeem_c74_to_usdt(p_c74 numeric)
+returns jsonb language plpgsql security definer set search_path to 'public' as $$
+declare
+  v_uid uuid := auth.uid();
+  s public.c74_swap_settings%rowtype;
+  v_points numeric; v_earned numeric; v_redeemed numeric; v_redeemable numeric;
+  v_usdt numeric; v_day numeric; v_life numeric;
+  v_swap_id uuid := gen_random_uuid();
+  v_new_points numeric; v_new_usdt numeric;
+begin
+  if v_uid is null then raise exception 'Unauthorized' using errcode = '28000'; end if;
+  if p_c74 is null or p_c74 <= 0 then raise exception 'Enter a valid C74 amount'; end if;
+
+  -- ── MASTER GATE (defense-in-depth, ADDED) ────────────────────────────────
+  -- This swap credits a withdrawable USDT balance ⇒ it is a money-out path.
+  -- Fail closed when real money is disabled, regardless of c74_swap_settings.enabled
+  -- and independent of apply_ledger_entry. Reporting/read paths are unaffected.
+  if not public.is_real_money_enabled() then
+    raise exception 'E_REAL_MONEY_OFF: C74 → USDT swap rejected (real money is disabled)'
+      using errcode = 'P0001';
+  end if;
+  -- ─────────────────────────────────────────────────────────────────────────
+
+  -- Serialize on the settings row so concurrent swaps can't overspend the pool.
+  select * into s from public.c74_swap_settings where id for update;
+  if not s.enabled then raise exception 'C74 → USDT swap is not available yet'; end if;
+  if p_c74 < s.min_c74 then raise exception 'Minimum swap is % C74', s.min_c74; end if;
+
+  -- Redeemable = min(current balance, play-earned − already redeemed).
+  select coalesce(energy_points,0) into v_points from public.user_energy where user_id = v_uid for update;
+  v_points := coalesce(v_points,0);
+  select coalesce(sum(delta),0) into v_earned from public.energy_ledger
+    where user_id = v_uid and delta > 0 and kind = any(s.redeemable_kinds);
+  select coalesce(-sum(delta),0) into v_redeemed from public.energy_ledger
+    where user_id = v_uid and kind = 'swap_redeem';
+  v_redeemable := greatest(0, least(v_points, v_earned - v_redeemed));
+  if p_c74 > v_redeemable then
+    raise exception 'Only % C74 is redeemable (earned from play)', round(v_redeemable, 4);
+  end if;
+
+  v_usdt := round(p_c74 * s.usdt_per_c74, 6);
+  if v_usdt <= 0 then raise exception 'Amount too small to swap'; end if;
+  if v_usdt > s.pool_usdt then raise exception 'Swap pool is temporarily empty — please try later'; end if;
+
+  select coalesce(sum(usdt_amount),0) into v_day from public.c74_swaps
+    where user_id = v_uid and created_at > now() - interval '24 hours';
+  if v_day + v_usdt > s.per_user_daily_usdt then
+    raise exception 'Daily swap limit reached (max %$ per 24h)', s.per_user_daily_usdt;
+  end if;
+  select coalesce(sum(usdt_amount),0) into v_life from public.c74_swaps where user_id = v_uid;
+  if v_life + v_usdt > s.per_user_lifetime_usdt then
+    raise exception 'Lifetime swap limit reached';
+  end if;
+
+  -- Deduct C74
+  update public.user_energy
+    set energy_points = energy_points - p_c74, energy_burned = energy_burned + p_c74, updated_at = now()
+    where user_id = v_uid;
+  insert into public.energy_ledger(user_id, delta, kind, reference)
+    values (v_uid, -p_c74, 'swap_redeem', v_swap_id::text);
+
+  -- Credit USDT (mirror deposit crediting: both profiles + casino_wallets)
+  update public.profiles set balance = coalesce(balance,0) + v_usdt, updated_at = now() where id = v_uid;
+  update public.casino_wallets set balance = coalesce(balance,0) + v_usdt, updated_at = now()
+    where user_id = v_uid
+    returning balance into v_new_usdt;
+  if v_new_usdt is null then raise exception 'Wallet not found for user'; end if;
+
+  -- Draw down the pool + audit
+  update public.c74_swap_settings set pool_usdt = pool_usdt - v_usdt, updated_at = now() where id;
+  insert into public.c74_swaps(id, user_id, c74_amount, usdt_amount, rate)
+    values (v_swap_id, v_uid, p_c74, v_usdt, s.usdt_per_c74);
+  insert into public.casino_transactions(user_id, type, amount, currency, reference_id, description, status)
+    values (v_uid, 'c74_swap', v_usdt, 'USDT', v_swap_id,
+            format('C74 → USDT swap (%s C74 @ %s USDT/C74)', p_c74, s.usdt_per_c74), 'completed');
+
+  -- Best-effort in-app notification (never blocks the swap)
+  begin
+    perform public.create_notification(
+      v_uid, 'bonus', 'C74 swapped to USDT',
+      public.fmt_money(v_usdt, 'USDT')||' credited from '||p_c74||' C74.',
+      jsonb_build_object('amount', v_usdt, 'currency', 'USDT', 'c74', p_c74,
+        'status','credited','icon','swap','cta_label','View Wallet','cta_route','/wallet'));
+  exception when others then null; end;
+
+  select energy_points into v_new_points from public.user_energy where user_id = v_uid;
+  return jsonb_build_object('success', true, 'c74_spent', p_c74, 'usdt_credited', v_usdt,
+    'rate', s.usdt_per_c74, 'new_c74_balance', v_new_points, 'new_usdt_balance', v_new_usdt);
+end $$;
+
+-- Preserve the original privilege posture (idempotent re-grant).
+revoke all on function public.redeem_c74_to_usdt(numeric) from public, anon;
+grant execute on function public.redeem_c74_to_usdt(numeric) to authenticated;
+
+comment on function public.redeem_c74_to_usdt(numeric) is
+  'C74 → USDT swap. Fail-closed under is_real_money_enabled() (money-out path); '
+  'preserves original caps/pool/idempotency. DRAFT gate — apply only with the '
+  'master-gate migration in an authorized change window.';
-- 
