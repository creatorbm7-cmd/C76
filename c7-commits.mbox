+# syntax=docker/dockerfile:1
+# ─────────────────────────────────────────────────────────────────────────────
+# Frontend-only static build — PRESENTATION PREVIEW.
+# Builds the Vite SPA and serves dist/ via nginx.
+# NO backend, NO volume, NO deposit/withdraw rail, NO money capability.
+# ─────────────────────────────────────────────────────────────────────────────
+FROM node:22-alpine AS build
+WORKDIR /app
+
+# Public, client-safe build vars only. These ship in the browser bundle by design
+# and are protected by Supabase RLS. Pass them at build time, e.g.:
+#   fly deploy --build-arg VITE_SUPABASE_URL=... --build-arg VITE_SUPABASE_ANON_KEY=...
+# Do NOT add SUPABASE_DB_PASSWORD, SUPABASE_ACCESS_TOKEN, PSP keys, or any secret.
+ARG VITE_SUPABASE_URL
+ARG VITE_SUPABASE_ANON_KEY
+ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL \
+    VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY
+
+COPY package*.json ./
+RUN npm ci
+COPY . .
+RUN npm run build
+
+# ── serve static output only ──
+FROM nginx:alpine AS serve
+COPY deploy/fly/nginx.conf /etc/nginx/conf.d/default.conf
+COPY --from=build /app/dist /usr/share/nginx/html
+EXPOSE 80
+CMD ["nginx", "-g", "daemon off;"]
