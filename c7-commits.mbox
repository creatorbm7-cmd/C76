--- /dev/null
+++ b/supabase/migrations/20260822120000_real_money_master_gate.sql
@@ -0,0 +1,219 @@
+-- =============================================================================
+-- Real-Money Master Gate — is_real_money_enabled() + enforcement + activation RPC
+-- =============================================================================
+-- Implements the unified real-money kill switch designed in
+-- docs/REAL-MONEY-MASTER-GATE-DESIGN.md and wires it into the authoritative DB
+-- money choke-point (apply_ledger_entry), which every real deposit/withdrawal
+-- routes through (razorpay-webhook, admin-credit-upi, deposit watchers,
+-- request_crypto_withdrawal).
+--
+-- FAIL-CLOSED: real_money_enabled absent / anything-but-'true' => OFF.
+-- DEFAULT OFF: the flag is seeded 'false'. This migration NEVER turns it on.
+--
+-- ⚠️ BEHAVIOUR CHANGE ON APPLY: with the flag OFF, real deposits and withdrawals
+-- are BLOCKED at the ledger (E_REAL_MONEY_OFF). This is the intended clean-OFF
+-- baseline (it closes the split state). APPLY ONLY IN A REVIEWED CHANGE WINDOW
+-- (Runbook Step 6) with the team aware that real money-in/out stops until the
+-- flag is turned on via admin_set_real_money_enabled() after the external gates.
+--
+-- Internal gameplay (bet/win/wager/bonus/jackpot) is NOT gated — only the
+-- real-money boundary (deposit/withdraw/withdrawal), matching the existing
+-- demo-mode gate's scope. No balances are modified by this migration.
+-- =============================================================================
+
+-- 1) Fail-closed helper -------------------------------------------------------
+CREATE OR REPLACE FUNCTION public.is_real_money_enabled()
+ RETURNS boolean
+ LANGUAGE sql
+ STABLE
+ SECURITY DEFINER
+ SET search_path TO 'public'
+AS $$
+  SELECT COALESCE((SELECT value = 'true' FROM public.platform_settings
+                   WHERE key = 'real_money_enabled'), false);
+$$;
+REVOKE ALL ON FUNCTION public.is_real_money_enabled() FROM public, anon;
+GRANT EXECUTE ON FUNCTION public.is_real_money_enabled() TO authenticated, service_role;
+
+-- 2) Seed the flag explicitly OFF (never force true) --------------------------
+INSERT INTO public.platform_settings(key, value)
+VALUES ('real_money_enabled', 'false')
+ON CONFLICT (key) DO NOTHING;
+
+-- 3) Wire the gate into the ledger choke-point --------------------------------
+--    Reproduces apply_ledger_entry verbatim (from 20260816140000) and adds ONE
+--    master-gate check beside the existing demo-mode gate. All other behaviour
+--    is preserved byte-for-byte.
+CREATE OR REPLACE FUNCTION public.apply_ledger_entry(
+  p_user_id uuid, p_amount numeric, p_type text, p_reference_id uuid,
+  p_idempotency_key text, p_description text DEFAULT NULL::text,
+  p_game_type text DEFAULT NULL::text)
+ RETURNS numeric
+ LANGUAGE plpgsql
+ SECURITY DEFINER
+ SET search_path TO 'public'
+AS $function$
+DECLARE
+  v_existing numeric;
+  v_before numeric;
+  v_after numeric;
+  v_quar boolean;
+  v_wagered numeric;
+  v_win_mult numeric;
+  v_win_floor numeric;
+  v_win_ceiling numeric;
+BEGIN
+  -- DEMO MODE GATE (covers both 'withdraw' singular + 'withdrawal' just in case)
+  IF p_type IN ('deposit', 'withdraw', 'withdrawal') AND public.is_platform_mode('demo') THEN
+    RAISE EXCEPTION 'E_DEMO_MODE: % rejected (free-play mode)', p_type USING ERRCODE = 'P0001';
+  END IF;
+
+  -- REAL-MONEY MASTER GATE (added): real deposits/withdrawals require the flag.
+  -- Fail-closed: absent/false => the real-money boundary is CLOSED. Internal
+  -- gameplay (bet/win/wager/bonus/jackpot) is unaffected — same scope as demo.
+  IF p_type IN ('deposit', 'withdraw', 'withdrawal') AND NOT public.is_real_money_enabled() THEN
+    RAISE EXCEPTION 'E_REAL_MONEY_OFF: % rejected (real money is disabled)', p_type USING ERRCODE = 'P0001';
+  END IF;
+
+  -- SELF-EXCLUSION GATE: a self-excluded player cannot place bets/wagers.
+  -- Withdrawals + credits are still allowed so they can cash out remaining funds.
+  IF p_type IN ('bet','wager') AND public.is_self_excluded(p_user_id) THEN
+    RAISE EXCEPTION 'E_SELF_EXCLUDED: self-excluded — wagering is blocked until it ends' USING ERRCODE = 'P0001';
+  END IF;
+
+  PERFORM set_config('app.ledger_engine', 'on', true);
+
+  IF p_idempotency_key IS NOT NULL THEN
+    SELECT balance_after INTO v_existing
+      FROM public.casino_transactions
+     WHERE idempotency_key = p_idempotency_key;
+    IF v_existing IS NOT NULL THEN RETURN v_existing; END IF;
+  END IF;
+
+  PERFORM pg_advisory_xact_lock(hashtext(p_user_id::text));
+
+  SELECT balance, quarantine, COALESCE(total_wagered, 0)
+    INTO v_before, v_quar, v_wagered
+    FROM public.casino_wallets
+   WHERE user_id = p_user_id AND currency='USDT'
+   FOR UPDATE;
+
+  IF NOT FOUND THEN
+    INSERT INTO public.casino_wallets (user_id, balance, currency)
+    VALUES (p_user_id, 0, 'USDT');
+    v_before := 0;
+    v_quar := false;
+    v_wagered := 0;
+  END IF;
+
+  IF v_quar AND COALESCE(current_setting('app.containment_bypass', true),'') <> 'on' THEN
+    RAISE EXCEPTION 'E_WALLET_QUARANTINED' USING ERRCODE = 'P0001';
+  END IF;
+
+  -- UNBACKED-WIN GUARD (see 20260816140000). A game 'win' must be backed by
+  -- wagering: reject one that exceeds GREATEST(floor, lifetime_wagered * mult).
+  IF p_type = 'win' AND p_amount > 0 THEN
+    v_win_mult  := COALESCE((SELECT value::numeric FROM public.platform_settings WHERE key = 'unbacked_win_mult'), 10000);
+    v_win_floor := COALESCE((SELECT value::numeric FROM public.platform_settings WHERE key = 'unbacked_win_floor_usdt'), 2000);
+    v_win_ceiling := GREATEST(v_win_floor, v_wagered * v_win_mult);
+    IF p_amount > v_win_ceiling THEN
+      RAISE EXCEPTION 'E_UNBACKED_WIN: win % exceeds wager-backed ceiling % (lifetime wagered %)',
+        p_amount, v_win_ceiling, v_wagered USING ERRCODE = 'P0001';
+    END IF;
+  END IF;
+
+  v_after := v_before + p_amount;
+  IF v_after < 0 THEN RAISE EXCEPTION 'INSUFFICIENT_BALANCE'; END IF;
+
+  UPDATE public.casino_wallets SET
+    balance         = v_after,
+    total_wagered   = CASE WHEN p_type='bet'        THEN total_wagered + ABS(p_amount) ELSE total_wagered END,
+    total_won       = CASE WHEN p_type='win'        THEN total_won + p_amount          ELSE total_won END,
+    total_deposited = CASE WHEN p_type='deposit'    THEN COALESCE(total_deposited,0) + p_amount ELSE total_deposited END,
+    total_withdrawn = CASE WHEN p_type IN ('withdraw','withdrawal') THEN COALESCE(total_withdrawn,0) + ABS(p_amount) ELSE total_withdrawn END,
+    updated_at      = now()
+  WHERE user_id = p_user_id AND currency='USDT';
+
+  INSERT INTO public.casino_transactions
+    (user_id, amount, type, reference_id, idempotency_key,
+     balance_before, balance_after, description, game_type, currency, engine)
+  VALUES
+    (p_user_id, p_amount, p_type, p_reference_id, p_idempotency_key,
+     v_before, v_after, p_description, p_game_type, 'USDT', 'v2');
+
+  IF p_type = 'bet' THEN
+    UPDATE public.bonus_claims
+       SET wagered      = COALESCE(wagered, 0) + ABS(p_amount),
+           status       = CASE WHEN COALESCE(wagered, 0) + ABS(p_amount) >= wagering_requirement
+                               THEN 'completed' ELSE status END,
+           completed_at = CASE WHEN COALESCE(wagered, 0) + ABS(p_amount) >= wagering_requirement
+                                AND completed_at IS NULL
+                               THEN now() ELSE completed_at END
+     WHERE user_id = p_user_id AND status = 'active';
+  END IF;
+
+  RETURN v_after;
+END $function$;
+
+-- 4) Governed activation RPC --------------------------------------------------
+--    Admin-only. ON requires the exact confirmation phrase AND passes a
+--    reserve-invariant safety net (DB-recorded; the Runbook still requires
+--    live on-chain verification + external gates before a human flips it).
+--    Every flip is written to audit_logs via log_audit_event.
+CREATE OR REPLACE FUNCTION public.admin_set_real_money_enabled(
+  p_on boolean,
+  p_confirm text DEFAULT NULL)
+ RETURNS jsonb
+ LANGUAGE plpgsql
+ SECURITY DEFINER
+ SET search_path TO 'public'
+AS $$
+DECLARE
+  v_liab numeric;
+  v_custody numeric;
+  v_pool numeric;
+BEGIN
+  IF NOT public.has_role(auth.uid(), 'admin') THEN
+    RAISE EXCEPTION 'E_FORBIDDEN: admin role required' USING ERRCODE = 'P0001';
+  END IF;
+
+  IF p_on THEN
+    -- Typed confirmation (defence against accidental enablement).
+    IF COALESCE(p_confirm, '') <> 'ENABLE REAL MONEY' THEN
+      RAISE EXCEPTION 'E_CONFIRM: type the exact confirmation phrase to enable real money'
+        USING ERRCODE = 'P0001';
+    END IF;
+
+    -- Reserve-invariant safety net: liquid custody must cover user liabilities
+    -- + the C74 swap pool. This is a FINAL guard, not a substitute for the
+    -- Runbook's live on-chain check and external gates.
+    SELECT COALESCE(sum(balance), 0) INTO v_liab   FROM public.casino_wallets;
+    SELECT COALESCE(sum(balance), 0) INTO v_custody FROM public.platform_wallets
+      WHERE wallet_type IN ('hot','cold') AND is_active;
+    SELECT COALESCE((SELECT pool_usdt FROM public.c74_swap_settings LIMIT 1), 0) INTO v_pool;
+
+    IF v_custody < (v_liab + v_pool) THEN
+      RAISE EXCEPTION 'E_INSOLVENT: liquid custody % < obligations % (liabilities % + swap pool %) — cannot enable real money',
+        v_custody, (v_liab + v_pool), v_liab, v_pool USING ERRCODE = 'P0001';
+    END IF;
+  END IF;
+
+  INSERT INTO public.platform_settings(key, value, updated_by, updated_at)
+  VALUES ('real_money_enabled', CASE WHEN p_on THEN 'true' ELSE 'false' END, auth.uid(), now())
+  ON CONFLICT (key) DO UPDATE
+    SET value = EXCLUDED.value, updated_by = EXCLUDED.updated_by, updated_at = now();
+
+  PERFORM public.log_audit_event(
+    auth.uid(),
+    CASE WHEN p_on THEN 'real_money_enabled_ON' ELSE 'real_money_enabled_OFF' END,
+    jsonb_build_object('confirmed', p_confirm IS NOT NULL, 'at', now()));
+
+  RETURN jsonb_build_object('ok', true, 'real_money_enabled', p_on);
+END $$;
+REVOKE ALL ON FUNCTION public.admin_set_real_money_enabled(boolean, text) FROM public, anon;
+GRANT EXECUTE ON FUNCTION public.admin_set_real_money_enabled(boolean, text) TO authenticated;
+
+COMMENT ON FUNCTION public.is_real_money_enabled() IS
+  'Fail-closed master gate: true only when platform_settings.real_money_enabled = ''true''.';
+COMMENT ON FUNCTION public.admin_set_real_money_enabled(boolean, text) IS
+  'Admin-only real-money activation. ON requires the confirmation phrase and passes a reserve-invariant safety net; every flip is audit-logged. Does NOT bypass the external go-live gates (license/PSP/treasury) — those are enforced procedurally by the Supervised Go-Live Runbook.';
-- 
