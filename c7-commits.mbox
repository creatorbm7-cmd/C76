+++ b/supabase/migrations/20260821070000_reconciliation_history.sql
@@ -0,0 +1,166 @@
+-- Reconciliation history — append-only audit trail.
+--
+-- Persists a snapshot each time an admin records a reconciliation run, so drift is
+-- auditable over time (compliance/audit history). STRICT guardrails:
+--   * Writes ONLY reconciliation_runs + reconciliation_exceptions. It never touches
+--     ledger / wallet / treasury / user balance / payout — nothing money moves.
+--   * Recording is ADMIN-TRIGGERED (a "Record run" action), not an automatic/frequent
+--     writer.
+--   * A snapshot stores ONLY totals, timestamp, run status, and exception
+--     classes/counts (+ a small capped sample) — never money-moving data.
+--   * Rows are IMMUTABLE: an UPDATE/DELETE trigger blocks any mutation, so every run
+--     is a permanent audit record. Inserts are the only allowed write.
+--   * No payment, payout, emission, or money movement anywhere in this migration.
+
+begin;
+
+-- ---- Tables -------------------------------------------------------------------
+create table if not exists public.reconciliation_runs (
+  id                     uuid primary key default gen_random_uuid(),
+  run_at                 timestamptz not null default now(),
+  recorded_by            uuid,
+  status                 text not null check (status in ('clean','exceptions')),
+  psp_settled_total      numeric,
+  onchain_credited_total numeric,
+  manual_approved_total  numeric,
+  inbound_sources_total  numeric,
+  ledger_deposit_total   numeric,
+  difference             numeric,
+  agree                  boolean,
+  exception_count        int not null default 0,
+  totals                 jsonb
+);
+
+create table if not exists public.reconciliation_exceptions (
+  id       uuid primary key default gen_random_uuid(),
+  run_id   uuid not null references public.reconciliation_runs(id),
+  class    text not null,
+  count    int  not null,
+  sample   jsonb
+);
+
+create index if not exists idx_recon_runs_run_at on public.reconciliation_runs (run_at desc);
+create index if not exists idx_recon_exc_run_id  on public.reconciliation_exceptions (run_id);
+
+-- ---- Immutability: block UPDATE/DELETE (append-only audit record) --------------
+create or replace function public.reconciliation_no_mutate()
+returns trigger language plpgsql as $$
+begin
+  raise exception 'reconciliation audit records are immutable (append-only)';
+end;
+$$;
+
+drop trigger if exists trg_recon_runs_immutable on public.reconciliation_runs;
+create trigger trg_recon_runs_immutable
+  before update or delete on public.reconciliation_runs
+  for each row execute function public.reconciliation_no_mutate();
+
+drop trigger if exists trg_recon_exc_immutable on public.reconciliation_exceptions;
+create trigger trg_recon_exc_immutable
+  before update or delete on public.reconciliation_exceptions
+  for each row execute function public.reconciliation_no_mutate();
+
+-- ---- RLS: no direct table access; reads for admins, writes only via the fn -----
+alter table public.reconciliation_runs       enable row level security;
+alter table public.reconciliation_exceptions enable row level security;
+
+drop policy if exists recon_runs_admin_read on public.reconciliation_runs;
+create policy recon_runs_admin_read on public.reconciliation_runs
+  for select to authenticated using (public.has_role(auth.uid(),'admin'));
+
+drop policy if exists recon_exc_admin_read on public.reconciliation_exceptions;
+create policy recon_exc_admin_read on public.reconciliation_exceptions
+  for select to authenticated using (public.has_role(auth.uid(),'admin'));
+
+revoke insert, update, delete on public.reconciliation_runs       from authenticated, anon;
+revoke insert, update, delete on public.reconciliation_exceptions from authenticated, anon;
+
+-- ---- Record a run (ADMIN-TRIGGERED; the only write path) -----------------------
+create or replace function public.admin_reconciliation_record_run()
+returns jsonb
+language plpgsql
+volatile
+security definer
+set search_path = public
+as $$
+declare
+  v_ov     jsonb;
+  v_tw     jsonb;
+  v_exc    jsonb;
+  v_status text;
+  v_run_id uuid;
+begin
+  if auth.uid() is null or not public.has_role(auth.uid(), 'admin') then
+    raise exception 'Forbidden';
+  end if;
+
+  -- Single source of truth: the read-only overview computes the current state.
+  v_ov  := public.admin_reconciliation_overview();
+  v_tw  := v_ov->'three_way';
+  v_exc := v_ov->'exceptions';
+  v_status := case when (v_ov->>'reconciled_clean')::boolean then 'clean' else 'exceptions' end;
+
+  insert into public.reconciliation_runs(
+    recorded_by, status, psp_settled_total, onchain_credited_total, manual_approved_total,
+    inbound_sources_total, ledger_deposit_total, difference, agree, exception_count, totals)
+  values(
+    auth.uid(), v_status,
+    (v_tw->>'psp_settled_total')::numeric, (v_tw->>'onchain_credited_total')::numeric,
+    (v_tw->>'manual_approved_total')::numeric, (v_tw->>'inbound_sources_total')::numeric,
+    (v_tw->>'ledger_deposit_total')::numeric, (v_tw->>'difference')::numeric,
+    (v_tw->>'agree')::boolean, (v_ov->>'exception_count')::int, v_tw)
+  returning id into v_run_id;
+
+  -- One immutable row per exception class that has any rows (count + capped sample).
+  insert into public.reconciliation_exceptions(run_id, class, count, sample)
+  select v_run_id, e.key, jsonb_array_length(e.value),
+         (select coalesce(jsonb_agg(x), '[]'::jsonb) from (
+            select x from jsonb_array_elements(e.value) x limit 5) s)
+  from jsonb_each(v_exc) e
+  where jsonb_typeof(e.value) = 'array' and jsonb_array_length(e.value) > 0;
+
+  return jsonb_build_object(
+    'run_id', v_run_id, 'recorded_at', now(), 'status', v_status,
+    'exception_count', (v_ov->>'exception_count')::int,
+    'difference', (v_tw->>'difference')::numeric, 'agree', (v_tw->>'agree')::boolean);
+end;
+$$;
+
+-- ---- Read the history (read-only) ---------------------------------------------
+create or replace function public.admin_reconciliation_history(p_limit int default 50)
+returns jsonb
+language plpgsql
+stable
+security definer
+set search_path = public
+as $$
+declare
+  v_limit int := least(greatest(coalesce(p_limit,50),1), 500);
+begin
+  if auth.uid() is null or not public.has_role(auth.uid(), 'admin') then
+    raise exception 'Forbidden';
+  end if;
+
+  return coalesce((
+    select jsonb_agg(r order by r.run_at desc)
+    from (
+      select run.id, run.run_at, run.status, run.difference, run.agree,
+             run.exception_count, run.inbound_sources_total, run.ledger_deposit_total,
+             substr(run.recorded_by::text,1,8) as recorded_by_short,
+             (select coalesce(jsonb_agg(jsonb_build_object('class', ex.class, 'count', ex.count)
+                              order by ex.count desc), '[]'::jsonb)
+                from public.reconciliation_exceptions ex where ex.run_id = run.id) as exceptions
+      from public.reconciliation_runs run
+      order by run.run_at desc
+      limit v_limit
+    ) r
+  ), '[]'::jsonb);
+end;
+$$;
+
+revoke all on function public.admin_reconciliation_record_run() from public;
+revoke all on function public.admin_reconciliation_history(int) from public;
+grant execute on function public.admin_reconciliation_record_run() to authenticated;
+grant execute on function public.admin_reconciliation_history(int) to authenticated;
+
+commit;
-- 
