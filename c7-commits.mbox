diff --git a/next-frontend/app/config/page.tsx b/next-frontend/app/config/page.tsx
new file mode 100644
index 0000000..efba2dc
--- /dev/null
+++ b/next-frontend/app/config/page.tsx
@@ -0,0 +1,64 @@
+import { cookies } from "next/headers";
+import { createClient } from "@/utils/supabase/server";
+import type { Tables } from "@/utils/supabase/database.types";
+
+// Typed data-fetch example. `site_config` is anon-readable (RLS: SELECT true),
+// so this renders without a session. The row type is inferred from the generated
+// Database types — no manual interface needed.
+type ConfigRow = Pick<Tables<"site_config">, "key" | "value" | "updated_at">;
+
+export const dynamic = "force-dynamic"; // always fetch fresh (no static caching)
+
+export default async function ConfigPage() {
+  const supabase = createClient(await cookies());
+
+  const { data, error } = await supabase
+    .from("site_config")
+    .select("key, value, updated_at")
+    .order("key");
+
+  const rows: ConfigRow[] = data ?? [];
+
+  return (
+    <main style={{ maxWidth: 720, margin: "48px auto", padding: 24 }}>
+      <h1>Site config</h1>
+      <p style={{ opacity: 0.8 }}>
+        Typed fetch from <code>site_config</code> via the SSR client. The row type is{" "}
+        <code>Tables&lt;&quot;site_config&quot;&gt;</code> — inferred from the generated schema.
+      </p>
+
+      {error ? (
+        <p style={{ color: "#ff6b7d" }}>Error: {error.message}</p>
+      ) : rows.length === 0 ? (
+        <p style={{ opacity: 0.6 }}>No rows.</p>
+      ) : (
+        <table style={{ width: "100%", borderCollapse: "collapse", marginTop: 12 }}>
+          <thead>
+            <tr style={{ textAlign: "left", opacity: 0.6, fontSize: 12 }}>
+              <th style={{ padding: "6px 8px" }}>key</th>
+              <th style={{ padding: "6px 8px" }}>value</th>
+              <th style={{ padding: "6px 8px" }}>updated</th>
+            </tr>
+          </thead>
+          <tbody>
+            {rows.map((r) => (
+              <tr key={r.key} style={{ borderTop: "1px solid rgba(255,255,255,0.08)" }}>
+                <td style={{ padding: "8px", fontWeight: 600 }}>{r.key}</td>
+                <td style={{ padding: "8px", fontFamily: "ui-monospace, monospace", fontSize: 13 }}>
+                  {JSON.stringify(r.value)}
+                </td>
+                <td style={{ padding: "8px", opacity: 0.7, fontSize: 12 }}>
+                  {new Date(r.updated_at).toLocaleString()}
+                </td>
+              </tr>
+            ))}
+          </tbody>
+        </table>
+      )}
+
+      <p style={{ marginTop: 20 }}>
+        <a href="/">← home</a>
+      </p>
+    </main>
+  );
+}
