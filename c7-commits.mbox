diff --git a/supabase/migrations/20260821050000_real_money_ops_overview.sql b/supabase/migrations/20260821050000_real_money_ops_overview.sql
new file mode 100644
index 0000000..96a9ddf
--- /dev/null
+++ b/supabase/migrations/20260821050000_real_money_ops_overview.sql
@@ -0,0 +1,124 @@
+-- Real-Money Ops overview — READ-ONLY operational-readiness surface backend.
+--
+-- The "Real-money Ops" admin view from REAL-MONEY-PAYMENT-LEDGER-WALLET-WITHDRAWAL.md
+-- §6: a single read-only pane over the real-money path — the enable flag, the L5
+-- solvency picture, the append-only ledger tail (with provenance), and the
+-- withdrawal queue with its L4 gate criteria.
+--
+-- HARD GUARANTEES:
+--   * Read-only. SELECT-only; enables nothing, moves nothing, corrects nothing.
+--   * real_money_enabled is a DESIGN flag; if the key is absent it is reported as
+--     "not provisioned — design-locked OFF", never assumed on.
+--   * Treasury/reserves are verified OFF-DB (on-chain). This function never invents
+--     an on-chain balance; it reports in-DB liabilities and labels the reserve leg
+--     as off-chain-verified, matching admin_treasury_status.
+
+begin;
+
+create or replace function public.admin_real_money_ops_overview()
+returns jsonb
+language plpgsql
+stable
+security definer
+set search_path = public
+as $$
+declare
+  v_flags        jsonb;
+  v_solvency     jsonb;
+  v_ledger_tail  jsonb;
+  v_withdrawals  jsonb;
+  v_rm_present   boolean;
+  v_rm_value     text;
+begin
+  if auth.uid() is null or not public.has_role(auth.uid(), 'admin') then
+    raise exception 'Forbidden';
+  end if;
+
+  -- ---- Flags (real-money-relevant subset of platform_settings) -----------------
+  select value into v_rm_value from platform_settings where key = 'real_money_enabled';
+  v_rm_present := found;
+
+  v_flags := jsonb_build_object(
+    'real_money_enabled', jsonb_build_object(
+      'present', v_rm_present,
+      'value',   coalesce(v_rm_value = 'true', false),
+      'note',    case when v_rm_present then null
+                      else 'not provisioned — design-locked OFF' end),
+    'c74_phase2_enabled',      (select coalesce(value='true',false) from platform_settings where key='c74_phase2_enabled'),
+    'auto_payout_enabled',     (select coalesce(value='true',false) from platform_settings where key='auto_payout_enabled'),
+    'kyc_auto_approve',        (select coalesce(value='true',false) from platform_settings where key='kyc_auto_approve'),
+    'withdrawal_auto_approve', jsonb_build_object(
+      'enabled',   (select coalesce(value='true',false) from platform_settings where key='withdrawal_auto_approve'),
+      'threshold', (select value from platform_settings where key='withdrawal_auto_approve_threshold'))
+  );
+
+  -- ---- L5 solvency (in-DB liabilities; reserve is off-chain verified) -----------
+  v_solvency := jsonb_build_object(
+    'user_liabilities_usdt',   coalesce((select round(sum(balance),2) from casino_wallets where currency='USDT' and not coalesce(quarantine,false)),0),
+    'liabilities_all_ccy',     coalesce((select round(sum(balance),2) from casino_wallets where not coalesce(quarantine,false)),0),
+    'quarantined_usdt',        coalesce((select round(sum(balance),2) from casino_wallets where coalesce(quarantine,false)),0),
+    'pending_payouts_usdt',    coalesce((select round(sum(amount),2) from crypto_withdrawals where status in ('pending','processing','approved')),0),
+    'platform_revenue_usdt',   coalesce((select round(sum(fee),2) from treasury_ledger),0),
+    'wallets_count',           (select count(*) from casino_wallets),
+    'reserve_note',            'Treasury/reserves are verified OFF-DB (on-chain hot+cold+deposit addresses). Compare that off-chain figure to user_liabilities for coverage; this view does not fabricate an on-chain balance.'
+  );
+
+  -- ---- Append-only ledger tail (with provenance) -------------------------------
+  select coalesce(jsonb_agg(t order by t.created_at desc), '[]'::jsonb)
+  into v_ledger_tail
+  from (
+    select
+      substr(user_id::text,1,8) as user_short,
+      type, round(amount,4) as amount, coalesce(currency,'—') as currency,
+      status, coalesce(idempotency_key, reference_id::text) as provenance,
+      created_at
+    from casino_transactions
+    order by created_at desc
+    limit 25
+  ) t;
+
+  -- ---- Withdrawal queue (both rails) + status breakdown ------------------------
+  select jsonb_build_object(
+    'gate_note', 'L4: a withdrawal executes ONLY if KYC-approved AND destination verified AND amount<=balance AND wagered>=deposited AND amount>0. This view classifies; it never approves or sends.',
+    'by_status', (
+      select coalesce(jsonb_object_agg(s, c), '{}'::jsonb) from (
+        select status s, count(*) c from (
+          select status from withdrawal_requests
+          union all select status from crypto_withdrawals
+        ) u group by status
+      ) q
+    ),
+    'recent', (
+      select coalesce(jsonb_agg(w order by w.created_at desc), '[]'::jsonb) from (
+        select 'crypto_withdrawals' as rail, substr(user_id::text,1,8) as user_short,
+               round(amount,4) as amount, round(coalesce(net_amount,amount),4) as net_amount,
+               round(coalesce(fee,0),4) as fee, status, coalesce(chain,'—') as chain,
+               tx_hash, created_at
+        from crypto_withdrawals
+        union all
+        select 'withdrawal_requests', substr(user_id::text,1,8),
+               round(amount,4), round(coalesce(net_amount,amount),4),
+               round(coalesce(fee,0),4), status, coalesce(chain,'—'),
+               tx_hash, created_at
+        from withdrawal_requests
+        order by created_at desc
+        limit 25
+      ) w
+    )
+  ) into v_withdrawals;
+
+  return jsonb_build_object(
+    'generated_at', now(),
+    'contract', 'Read-only real-money operations view. Enables nothing, moves nothing, corrects nothing. real_money_enabled stays OFF until the external gates (license, PSP, treasury, compliance) are met and an operator explicitly flips it.',
+    'flags', v_flags,
+    'solvency', v_solvency,
+    'ledger_tail', v_ledger_tail,
+    'withdrawals', v_withdrawals
+  );
+end;
+$$;
+
+revoke all on function public.admin_real_money_ops_overview() from public;
+grant execute on function public.admin_real_money_ops_overview() to authenticated;
+
+commit;
-- 
