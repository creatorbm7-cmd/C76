From 5fb8dc2c9862cd60d711d192b1a9b4b91fe1ea5c Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 26 Aug 2026 10:58:39 +0000
Subject: [PATCH 110/137] chore(mcp): add VS Code GitHub Copilot MCP config
 (.vscode/mcp.json)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Canonical VS Code MCP config for the GitHub Copilot HTTP server. Auth uses a
password promptString input (${input:github_mcp_pat}) — the PAT is entered at
prompt time and is NEVER stored in the file. .gitignore uses .vscode/* so this
one shared file is un-ignored while the rest of .vscode/ stays personal.
No secret committed.
---
 .gitignore       |  3 ++-
 .vscode/mcp.json | 19 +++++++++++++++++++
 2 files changed, 21 insertions(+), 1 deletion(-)
 create mode 100644 .vscode/mcp.json

diff --git a/.gitignore b/.gitignore
index 4fe33ec..c240d45 100644
--- a/.gitignore
+++ b/.gitignore
@@ -13,7 +13,8 @@ build/
 !*.example
 
 # Editor / OS
-.vscode/
+.vscode/*
+!.vscode/mcp.json
 .idea/
 .DS_Store
 Thumbs.db
diff --git a/.vscode/mcp.json b/.vscode/mcp.json
new file mode 100644
index 0000000..0797f02
--- /dev/null
+++ b/.vscode/mcp.json
@@ -0,0 +1,19 @@
+{
+  "servers": {
+    "github": {
+      "type": "http",
+      "url": "https://api.githubcopilot.com/mcp/",
+      "headers": {
+        "Authorization": "Bearer ${input:github_mcp_pat}"
+      }
+    }
+  },
+  "inputs": [
+    {
+      "type": "promptString",
+      "id": "github_mcp_pat",
+      "description": "GitHub Personal Access Token",
+      "password": true
+    }
+  ]
+}
-- 
