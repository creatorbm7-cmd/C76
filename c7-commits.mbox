From ac39cb83f728ec3804cee2fd6936d0bbd29707a0 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 23 Aug 2026 10:03:05 +0000
Subject: [PATCH 095/137] test: full local integration harness for
 razorpay-webhook (branch-only, prod-guarded)

End-to-end deposit-credit test for a LOCAL supabase stack or isolated Pro branch:
signed capture credits once, replay is idempotent, tampered signature 401s, unknown
order is ignored. Seeds/tears down its own throwaway user + deposit row. Hard-refuses
the production project ref and non-local/non-branch targets. Does not enable any money
rail; real_money_enabled stays OFF. Not run against production; nothing deployed.
---
 .../tests/razorpay-webhook.local-test.mjs     | 171 ++++++++++++++++++
 1 file changed, 171 insertions(+)
 create mode 100644 supabase/tests/razorpay-webhook.local-test.mjs

diff --git a/supabase/tests/razorpay-webhook.local-test.mjs b/supabase/tests/razorpay-webhook.local-test.mjs
new file mode 100644
index 0000000..0aadccc
--- /dev/null
+++ b/supabase/tests/razorpay-webhook.local-test.mjs
@@ -0,0 +1,171 @@
+#!/usr/bin/env node
+/**
+ * razorpay-webhook — full local integration harness  (BRANCH-ONLY · NOT for production)
+ * ---------------------------------------------------------------------------------------
+ * Exercises the whole deposit-credit path end-to-end against a LOCAL Supabase stack
+ * (`supabase start`) or an ISOLATED Pro branch — never production:
+ *
+ *   1. HMAC-signed `payment.captured` → 200, wallet credited exactly `deposit.amount`
+ *   2. Replay the SAME webhook       → 200, NO double-credit (idempotent on payment id)
+ *   3. Tampered signature            → 401, nothing credited
+ *   4. Unknown order id              → 200 ignored, nothing credited
+ *
+ * It SEEDS its own throwaway user + pending deposit row and TEARS THEM DOWN after.
+ *
+ * ── Safety ────────────────────────────────────────────────────────────────────────────
+ * This harness WRITES to the database it points at (inserts, credits, deletes). It will
+ * HARD-REFUSE to run against the known production project ref. Point it only at a local
+ * stack or an isolated branch. `real_money_enabled` must stay OFF regardless — this only
+ * tests the deposit-credit mechanics, it does not enable any money rail.
+ *
+ * ── Usage ─────────────────────────────────────────────────────────────────────────────
+ *   supabase start                      # or provision an isolated Pro branch
+ *   supabase functions serve razorpay-webhook --no-verify-jwt --env-file supabase/.env.local
+ *
+ *   SUPABASE_URL=http://127.0.0.1:54321 \
+ *   SUPABASE_SERVICE_ROLE_KEY=<local service_role key> \
+ *   RAZORPAY_WEBHOOK_SECRET=whsec_local_test \
+ *   WEBHOOK_URL=http://127.0.0.1:54321/functions/v1/razorpay-webhook \
+ *   node supabase/tests/razorpay-webhook.local-test.mjs
+ *
+ * The RAZORPAY_WEBHOOK_SECRET here MUST match what the served function reads (env or the
+ * gateway_secrets store on the local/branch DB).
+ */
+import { createClient } from '@supabase/supabase-js';
+import { webcrypto as crypto } from 'node:crypto';
+
+const enc = new TextEncoder();
+
+// ── env ────────────────────────────────────────────────────────────────────────────────
+const SUPABASE_URL = process.env.SUPABASE_URL;
+const SERVICE_ROLE = process.env.SUPABASE_SERVICE_ROLE_KEY;
+const SECRET = process.env.RAZORPAY_WEBHOOK_SECRET;
+const WEBHOOK_URL = process.env.WEBHOOK_URL || (SUPABASE_URL ? `${SUPABASE_URL}/functions/v1/razorpay-webhook` : '');
+const PROD_REFS = ['smcwrriaraptzjhqdktg']; // known production project ref(s) — never target these
+
+function die(msg) { console.error(`\n✋ ${msg}\n`); process.exit(2); }
+
+if (!SUPABASE_URL || !SERVICE_ROLE || !SECRET) {
+  die('Missing env. Required: SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, RAZORPAY_WEBHOOK_SECRET (WEBHOOK_URL optional).');
+}
+// HARD production guard.
+for (const ref of PROD_REFS) {
+  if (SUPABASE_URL.includes(ref) || WEBHOOK_URL.includes(ref)) {
+    die(`Refusing to run: target looks like PRODUCTION (${ref}). This harness is branch/local only.`);
+  }
+}
+const isLocal = /^https?:\/\/(127\.0\.0\.1|localhost|0\.0\.0\.0|\[?::1\]?)(:\d+)?/i.test(SUPABASE_URL);
+const looksBranch = /\.supabase\.(co|net)/i.test(SUPABASE_URL) && !PROD_REFS.some(r => SUPABASE_URL.includes(r));
+if (!isLocal && !looksBranch) {
+  if (process.env.ALLOW_NONPROD_TARGET !== '1') {
+    die(`Target ${SUPABASE_URL} is neither localhost nor an obvious branch host. If this is an isolated branch, re-run with ALLOW_NONPROD_TARGET=1.`);
+  }
+}
+
+// ── crypto (mirrors the function VERBATIM) ──────────────────────────────────────────────
+function toHex(buf) { return Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2, '0')).join(''); }
+async function hmacSha256Hex(secret, body) {
+  const key = await crypto.subtle.importKey('raw', enc.encode(secret), { name: 'HMAC', hash: 'SHA-256' }, false, ['sign']);
+  return toHex(await crypto.subtle.sign('HMAC', key, enc.encode(body)));
+}
+
+// ── harness state ───────────────────────────────────────────────────────────────────────
+const admin = createClient(SUPABASE_URL, SERVICE_ROLE, { auth: { persistSession: false } });
+const stamp = Date.now();
+const USER_ID = process.env.TEST_USER_ID || crypto.randomUUID();
+const SEED_USER = !process.env.TEST_USER_ID;
+const ORDER_ID = `order_LOCALTEST_${stamp}`;
+const PAYMENT_ID = `pay_LOCALTEST_${stamp}`;
+const AMOUNT_USDT = 5;
+const DEPOSIT_ID = crypto.randomUUID();
+
+let pass = 0, fail = 0;
+const check = (name, cond, extra = '') => { cond ? pass++ : fail++; console.log(`${cond ? '✅ PASS' : '❌ FAIL'} — ${name}${extra ? '  ·  ' + extra : ''}`); };
+
+async function balanceOf(userId) {
+  const { data } = await admin.from('profiles').select('balance').eq('id', userId).maybeSingle();
+  return data ? Number(data.balance) : null;
+}
+
+function webhookBody(paise = AMOUNT_USDT * 100 * 83 /* ~inr */) {
+  return JSON.stringify({
+    event: 'payment.captured',
+    payload: { payment: { entity: {
+      id: PAYMENT_ID, order_id: ORDER_ID, amount: paise,
+      notes: { deposit_id: DEPOSIT_ID, inr: paise / 100 },
+    } } },
+  });
+}
+
+async function postWebhook(body, sig) {
+  const res = await fetch(WEBHOOK_URL, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json', 'x-razorpay-signature': sig },
+    body,
+  });
+  let json = null; try { json = await res.json(); } catch {}
+  return { status: res.status, json };
+}
+
+async function main() {
+  console.log(`\n▶ razorpay-webhook local harness → ${SUPABASE_URL}`);
+  console.log(`   user=${USER_ID.slice(0, 8)}…  order=${ORDER_ID}  amount=${AMOUNT_USDT} USDT\n`);
+
+  // ── seed ──────────────────────────────────────────────────────────────────────────────
+  if (SEED_USER) {
+    const { error } = await admin.from('profiles').insert({ id: USER_ID, balance: 0 });
+    if (error) die(`Seed profile failed (${error.message}). Pass TEST_USER_ID=<existing user> to skip user seeding.`);
+  }
+  const before = await balanceOf(USER_ID);
+  const { error: depErr } = await admin.from('deposit_requests').insert({
+    id: DEPOSIT_ID, user_id: USER_ID, amount: AMOUNT_USDT, status: 'pending',
+    method: 'razorpay', reference: ORDER_ID,
+  });
+  if (depErr) die(`Seed deposit_requests failed: ${depErr.message} (columns may differ on this schema — adjust the insert).`);
+  console.log(`   seeded · starting balance = ${before}\n`);
+
+  const body = webhookBody();
+  const goodSig = await hmacSha256Hex(SECRET, body);
+
+  // ── 1) valid signed capture credits exactly once ────────────────────────────────────────
+  const r1 = await postWebhook(body, goodSig);
+  check('valid capture → 200', r1.status === 200, `status=${r1.status}`);
+  check('response reports credited amount', r1.json?.credited === AMOUNT_USDT, JSON.stringify(r1.json));
+  const afterCredit = await balanceOf(USER_ID);
+  check('balance increased by deposit amount', afterCredit === (before ?? 0) + AMOUNT_USDT, `${before} → ${afterCredit}`);
+  const { data: depRow1 } = await admin.from('deposit_requests').select('status').eq('id', DEPOSIT_ID).maybeSingle();
+  check('deposit marked credited', depRow1?.status === 'credited', `status=${depRow1?.status}`);
+
+  // ── 2) replay is idempotent (no double credit) ──────────────────────────────────────────
+  const r2 = await postWebhook(body, goodSig);
+  check('replay → 200', r2.status === 200, `status=${r2.status}`);
+  const afterReplay = await balanceOf(USER_ID);
+  check('replay does NOT double-credit', afterReplay === afterCredit, `${afterCredit} → ${afterReplay}`);
+
+  // ── 3) tampered signature rejected ──────────────────────────────────────────────────────
+  const r3 = await postWebhook(body, goodSig.slice(0, -1) + (goodSig.endsWith('a') ? 'b' : 'a'));
+  check('tampered signature → 401', r3.status === 401, `status=${r3.status}`);
+  const afterTamper = await balanceOf(USER_ID);
+  check('tampered attempt credits nothing', afterTamper === afterReplay, `${afterReplay} → ${afterTamper}`);
+
+  // ── 4) unknown order id acknowledged, not credited ──────────────────────────────────────
+  const unknownBody = JSON.stringify({
+    event: 'payment.captured',
+    payload: { payment: { entity: { id: `pay_UNKNOWN_${stamp}`, order_id: `order_UNKNOWN_${stamp}`, amount: 100000, notes: {} } } },
+  });
+  const r4 = await postWebhook(unknownBody, await hmacSha256Hex(SECRET, unknownBody));
+  check('unknown order → 200 ignored', r4.status === 200 && r4.json?.ignored, JSON.stringify(r4.json));
+
+  // ── teardown ────────────────────────────────────────────────────────────────────────────
+  try {
+    await admin.from('ledger_entries').delete().eq('idempotency_key', `razorpay:${PAYMENT_ID}`);
+  } catch {}
+  await admin.from('deposit_requests').delete().eq('id', DEPOSIT_ID);
+  if (SEED_USER) await admin.from('profiles').delete().eq('id', USER_ID);
+  console.log('\n   torn down seeded rows (best-effort).');
+
+  console.log(`\n════════════════════════════════════════\nRESULT: ${pass} passed, ${fail} failed\n════════════════════════════════════════`);
+  process.exit(fail ? 1 : 0);
+}
+
+main().catch((e) => { console.error('\n💥 harness error:', e); process.exit(1); });
-- 
