+-- ═══════════════════════════════════════════════════════════════════════════
+-- INBOUND-OFF CHANGE-SET — ⛔ REVIEW ONLY · DO NOT APPLY OUTSIDE A CHANGE WINDOW
+--
+-- Placed OUTSIDE supabase/migrations/ on purpose: it is NOT a migration and is
+-- NOT picked up by `supabase db push`. It is a hand-run, dual-control change-
+-- window script. Applying it changes PRODUCTION money-flow configuration.
+--
+-- Nothing here has been executed. `real_money_enabled` is ABSENT → OFF. This
+-- script only flips INBOUND / policy controls OFF; it does not enable anything.
+--
+-- Scope: config rows only (platform_settings, admin_casino_config, site_config)
+--        + the c74_swap_settings.enabled flag. No DDL, no schema, no data
+--        migration. Fully reversible (see ROLLBACK).
+--
+-- Companion audits:
+--   docs/audits/2026-08-22-phase-0-8-system-green-status.md
+--   docs/audits/2026-08-22-system-8-treasury-c74-swap-deep-dive.md
+--   docs/REAL-MONEY-INBOUND-OFF-CHANGESET.md
+-- ═══════════════════════════════════════════════════════════════════════════
+
+
+-- ── 0. LIVE SNAPSHOT (captured read-only 2026-08-22, project smcwrriaraptzjhqdktg)
+--    Value-type notes: platform_settings.value = TEXT; admin_casino_config.value
+--    = JSONB; site_config.value = JSONB; c74_swap_settings.enabled = boolean.
+--
+--   platform_settings.mode                    = 'live'          -> target 'demo'
+--   platform_settings.withdrawal_auto_approve = 'true'          -> target 'false'
+--   platform_settings.kyc_auto_approve        = 'true'          -> target 'false'
+--   platform_settings.real_money_enabled      = (absent)        -> seed 'false'
+--   platform_settings.auto_payout_enabled     = 'false'         -> UNCHANGED (already OFF)
+--   platform_settings.c74_phase2_enabled      = 'false'         -> UNCHANGED (already OFF)
+--   admin_casino_config.deposits_enabled      = {"enabled":true}-> {"enabled":false}
+--   admin_casino_config.razorpay_mode         = {"mode":"live"} -> leave (inert once deposits off)
+--   site_config.evm_deposits_enabled          = true            -> false
+--   site_config.btc_deposits_enabled          = true            -> false
+--   site_config.ton_deposits_enabled          = true            -> false
+--   c74_swap_settings.enabled                 = true            -> false
+
+
+-- ── 1. PRE-FLIGHT (run first; all must pass before APPLY) ────────────────────
+-- 1a. No in-flight inbound money (any non-zero => HOLD, do not apply):
+--   select count(*) from deposit_requests where status in ('pending','created','awaiting_payment');
+-- 1b. No in-flight swap redemptions are possible mid-transaction (serialized by
+--     the settings row FOR UPDATE) — informational:
+--   select enabled, pool_usdt from c74_swap_settings;
+-- 1c. Capture exact rollback backup NOW:
+--   select key, value from platform_settings
+--     where key in ('mode','withdrawal_auto_approve','kyc_auto_approve','real_money_enabled');
+--   select key, value from admin_casino_config where key in ('deposits_enabled','razorpay_mode');
+--   select key, value from site_config
+--     where key in ('evm_deposits_enabled','btc_deposits_enabled','ton_deposits_enabled');
+--   select id, enabled, pool_usdt from c74_swap_settings;
+
+
+-- ── 2. APPLY (single transaction — all-or-nothing) ──────────────────────────
+begin;
+
+-- 2.1 Platform mode -> demo (stop routing users into the real /deposit flow)
+update platform_settings set value = 'demo', updated_at = now() where key = 'mode';
+
+-- 2.2 Restore human review: auto-approve OFF (withdrawals + KYC)
+update platform_settings set value = 'false', updated_at = now() where key = 'withdrawal_auto_approve';
+update platform_settings set value = 'false', updated_at = now() where key = 'kyc_auto_approve';
+
+-- 2.3 Seed the master gate explicitly OFF (never force true; fail-closed)
+insert into platform_settings(key, value, updated_at)
+values ('real_money_enabled', 'false', now())
+on conflict (key) do nothing;
+
+-- 2.4 Fiat / Razorpay deposits OFF (flip enabled inside the jsonb blob)
+update admin_casino_config
+   set value = jsonb_set(value, '{enabled}', 'false'::jsonb, false), updated_at = now()
+ where key = 'deposits_enabled';
+
+-- 2.5 On-chain deposit rails OFF
+update site_config set value = 'false'::jsonb, updated_at = now()
+ where key in ('evm_deposits_enabled','btc_deposits_enabled','ton_deposits_enabled');
+
+-- 2.6 C74 -> USDT swap OFF (closes the platform-side coin->cash path; see
+--     System #8 deep-dive). Complements the fail-closed code guard drafted in
+--     supabase/migrations/20260822130000_c74_swap_master_gate.sql.
+update c74_swap_settings set enabled = false, updated_at = now() where id;
+
+commit;
+
+
+-- ── 3. VERIFY (run after APPLY; every row must read the target) ──────────────
+--   select key, value from platform_settings
+--     where key in ('mode','withdrawal_auto_approve','kyc_auto_approve','real_money_enabled');
+--     -- expect: demo, false, false, false
+--   select value->>'enabled' from admin_casino_config where key='deposits_enabled';  -- expect: false
+--   select key, value from site_config
+--     where key in ('evm_deposits_enabled','btc_deposits_enabled','ton_deposits_enabled'); -- expect: false ×3
+--   select enabled from c74_swap_settings;  -- expect: false
+--   -- payout side already OFF (unchanged):
+--   select key, value from platform_settings where key in ('auto_payout_enabled','c74_phase2_enabled');
+
+
+-- ── 4. ROLLBACK (restore the §0 snapshot) ───────────────────────────────────
+-- begin;
+--   update platform_settings set value='live',  updated_at=now() where key='mode';
+--   update platform_settings set value='true',  updated_at=now() where key='withdrawal_auto_approve';
+--   update platform_settings set value='true',  updated_at=now() where key='kyc_auto_approve';
+--   update admin_casino_config set value=jsonb_set(value,'{enabled}','true'::jsonb,false), updated_at=now()
+--     where key='deposits_enabled';
+--   update site_config set value='true'::jsonb, updated_at=now()
+--     where key in ('evm_deposits_enabled','btc_deposits_enabled','ton_deposits_enabled');
+--   update c74_swap_settings set enabled=true, updated_at=now() where id;
+--   -- NOTE: real_money_enabled='false' (2.3) is intentionally NOT rolled back —
+--   --       an explicit fail-closed OFF is safe and desirable to keep.
+-- commit;
+--
+-- Prefer restoring from the §1c JSON backup for byte-exact rollback if a blob
+-- changed since snapshot.
+
+-- ═══════════════════════════════════════════════════════════════════════════
+-- END — not executed by this branch. Change-window + dual-control required.
