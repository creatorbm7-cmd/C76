+.igco-tier--silver  { color:#475569; border-color:rgba(100,116,139,.4); background:rgba(100,116,139,.08); }
+.igco-tier--bronze  { color:#8a5a2b; border-color:rgba(180,120,80,.4);  background:rgba(180,120,80,.08); }
+.igco-mult { font-size:12px; font-weight:700; color:var(--mut); }
+.igco-hint { font-size:12px; color:var(--mut); margin:8px 0 0; }
+.igco-note { display:flex; gap:8px; align-items:flex-start; margin:14px 0; padding:10px 12px; border-radius:12px;
+  background:rgba(217,154,31,.07); border:1px solid rgba(217,154,31,.28); color:#92600b; font-size:11.5px; line-height:1.45; }
+.igco-note svg { flex:0 0 auto; margin-top:1px; }
+.igco-sec { display:flex; align-items:center; gap:6px; font-size:12px; font-weight:800; color:var(--mut); text-transform:uppercase; letter-spacing:.04em; margin:6px 2px 8px; }
