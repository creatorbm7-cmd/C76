+-- ─────────────────────────────────────────────────────────────────────────
+-- DRAFT — NOT APPLIED. System #7 security hardening (part 1 of 2: DB layer).
+--
+-- FINDING (Supabase security advisor, 3× ERROR `security_definer_view`):
+--   public.treasury_summary, public.c74_reserve_status, public.v_igaming_ggr
+--   are owned by `postgres` and were (re)created WITHOUT `security_invoker`, so
+--   they run with the VIEW OWNER's privileges and BYPASS RLS on the underlying
+--   money tables. They are additionally SELECT-granted to `anon` AND
+--   `authenticated`, so an anonymous or any signed-in user can read aggregate
+--   treasury balances, C74 reserve, and daily GGR. (A historical migration
+--   `20260222191842` had set security_invoker=true on treasury_summary; a later
+--   CREATE OR REPLACE VIEW silently reset it to the definer default.)
+--
+-- FIX (least-privilege, definition-preserving):
+--   1. `ALTER VIEW … SET (security_invoker = true)` — the view now runs with the
+--      QUERYING role's privileges, so RLS on the underlying tables applies. This
+--      does NOT change the view's SQL/definition. `service_role` (BYPASSRLS) keeps
+--      full visibility, so the admin edge-function reads are unaffected.
+--   2. `REVOKE SELECT … FROM anon` — anonymous users have no legitimate need for
+--      treasury / reserve / GGR aggregates. (The ops script `c74-status/status.js`
+--      uses the service-role key, not anon, so it is unaffected.)
+--
+-- COMPATIBILITY NOTE (verify in the change window BEFORE relying on it):
+--   `src/hooks/useTreasury.ts` reads `treasury_summary` as an AUTHENTICATED admin
+--   client (not service_role). After security_invoker=true, that read depends on
+--   the underlying tables' RLS granting admins SELECT. Change-window step: confirm
+--   an admin session still returns treasury_summary rows. Recommended follow-up
+--   (separate change): reroute useTreasury to the `admin-casino` service-role read
+--   and then also `REVOKE SELECT … FROM authenticated` for full least-privilege.
+--
+-- SAFETY: no data touched; no DDL that redefines the views; reversible (see the
+-- companion doc). NOT applied / not deployed by this branch.
+-- ─────────────────────────────────────────────────────────────────────────
+
+alter view public.treasury_summary   set (security_invoker = true);
+alter view public.c74_reserve_status  set (security_invoker = true);
+alter view public.v_igaming_ggr       set (security_invoker = true);
+
+revoke select on public.treasury_summary  from anon;
+revoke select on public.c74_reserve_status from anon;
+revoke select on public.v_igaming_ggr      from anon;
+
+comment on view public.treasury_summary  is 'Treasury totals. security_invoker=true; RLS-scoped; not anon-readable.';
+comment on view public.c74_reserve_status is 'C74 reserve status. security_invoker=true; RLS-scoped; not anon-readable.';
+comment on view public.v_igaming_ggr      is 'Daily 2J/igaming GGR. security_invoker=true; RLS-scoped; not anon-readable.';
-- 
