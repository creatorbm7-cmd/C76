+// IgContribution (/ig/contribution) — the user's own C74 Contribution Score,
+// Instagram-light. Shows HOW the score is built from genuine activity
+// (gameplay / loyalty / reputation / referrals / VIP). Read-only; it makes NO
+// earnings promise — actual C74 depends on availability, caps and the reserve.
+// Data comes only from the real RPC c74_my_contribution().
+import { useEffect, useState } from "react";
+import { useNavigate } from "react-router-dom";
+import { num as fmt } from "@/lib/format";
+import { supabase } from "@/integrations/supabase/client";
+import { ArrowLeft, Sparkles, Info, Gamepad2, Heart, ShieldCheck, Users, Crown } from "lucide-react";
+import IgTabBar from "@/components/ig/IgTabBar";
+
+interface Part { label: string; raw: number; weight: number; points: number; }
+interface Contribution {
+  score: number; tier: string; multiplier: number; eligible: boolean;
+  breakdown: Part[]; note: string;
+}
+
+const ICONS: Record<string, JSX.Element> = {
+  "Gameplay (wager)": <Gamepad2 size={16} />,
+  "Loyalty (energy)": <Heart size={16} />,
+  "Reputation": <ShieldCheck size={16} />,
+  "Referrals": <Users size={16} />,
+  "VIP": <Crown size={16} />,
+};
+
+export default function IgContribution() {
+  const nav = useNavigate();
+  const [data, setData] = useState<Contribution | null>(null);
+  const [loading, setLoading] = useState(true);
+
+  useEffect(() => {
+    (async () => {
+      const { data, error } = await (supabase.rpc as any)("c74_my_contribution");
+      if (!error && data) setData(data as Contribution);
+      setLoading(false);
+    })();
+  }, []);
+
+  const maxPoints = data ? Math.max(1, ...data.breakdown.map((p) => p.points)) : 1;
+
+  return (
+    <div className="ig igco">
+      <style>{CSS}</style>
+
+      <header className="ig-top">
+        <button className="igco-back" onClick={() => (window.history.length > 1 ? nav(-1) : nav("/ig"))} aria-label="Back"><ArrowLeft size={22} /></button>
+        <span className="ig-ttl">Contribution Score</span>
+        <span style={{ width: 22 }} />
+      </header>
+
+      <main className="ig-main igco-main">
+        {loading ? (
+          <div className="igco-empty">Loading…</div>
+        ) : !data ? (
+          <div className="igco-empty">Sign in to see your Contribution Score.</div>
+        ) : (
+          <>
+            {/* Hero score */}
+            <div className="igco-hero">
+              <div className="igco-score ig-sheen">{fmt(data.score)}</div>
+              <div className="igco-sub">
+                <span className={`igco-tier igco-tier--${data.tier.toLowerCase()}`}>{data.tier}</span>
+                <span className="igco-mult">{data.multiplier.toFixed(2)}× reward tier</span>
+              </div>
+              <p className="igco-hint">Earned from your genuine activity on C7.</p>
+            </div>
+
+            {/* Not-guaranteed contract */}
+            <div className="igco-note"><Info size={14} /><span>{data.note}</span></div>
+
+            {/* Breakdown */}
+            <div className="igco-sec"><Sparkles size={14} /> <span>How your score is built</span></div>
+            <div className="igco-card">
+              {data.breakdown.map((p, i) => (
+                <div key={p.label} className="igco-row" style={{ borderTop: i ? "1px solid var(--line)" : "none" }}>
+                  <span className="igco-ic">{ICONS[p.label] ?? <Sparkles size={16} />}</span>
+                  <div className="igco-rtx">
+                    <div className="igco-rtop"><b>{p.label}</b><span className="igco-pts">{fmt(p.points)} pts</span></div>
+                    <div className="igco-bar"><span style={{ width: `${Math.max(3, (p.points / maxPoints) * 100)}%` }} /></div>
+                    <small>{fmt(p.raw)} × {p.weight}</small>
+                  </div>
+                </div>
+              ))}
+            </div>
+
+            <p className="igco-foot">Play fair, complete missions, keep your streak and invite real friends to grow your score. Your score is not a guaranteed payout — it sets your reward tier when C74 rewards are available.</p>
+          </>
+        )}
+      </main>
+
+      <IgTabBar active="profile" />
+    </div>
+  );
+}
+
+const CSS = `
+.igco { min-height:100vh; background:var(--bg); }
+.igco-back { background:none; border:none; color:var(--ink); cursor:pointer; padding:4px; }
+.igco-main { padding:14px 16px 90px; }
