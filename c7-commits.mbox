new file mode 100644
index 0000000..afa5c64
--- /dev/null
+++ b/supabase/migrations/20260821040000_reconciliation_overview.sql
@@ -0,0 +1,192 @@
+-- Reconciliation overview — READ-ONLY three-way tie-out (admin surface backend).
+--
+-- Implements the reconciliation design (docs/PSP-RECONCILIATION-DESIGN.md) against
+-- the REAL tables, honestly: it computes per-leg totals and the exception classes
+-- (R3 orphan / R4 missing-credit / R5 idempotency) from live data, and where a leg
+-- has no data yet (e.g. no gateway settlements ingested) it simply reports zero —
+-- it never fabricates a settlement.
+--
+-- HARD GUARANTEES:
+--   * Read-only. SELECT-only; it credits/debits/corrects NOTHING. Remediation of any
+--     exception stays a separate, dual-controlled, human action outside this function.
+--   * No money movement, no emission, no flag flips. Purely observational.
+--
+-- The three legs of the same money:
+--   PSP settlement  = fiat_topups        (provider_payment_id)
+--   Internal ledger = casino_transactions (type='deposit')
+--   Bank/on-chain   = crypto_deposits + blockchain_deposits + incoming_deposits (tx_hash)
+--                     + deposit_requests (manual, approved)
+-- Every credited inbound source should equal the ledger deposit credits.
+
+begin;
+
+create or replace function public.admin_reconciliation_overview()
+returns jsonb
+language plpgsql
+stable
+security definer
+set search_path = public
+as $$
+declare
+  v_tol            numeric := 0.01;   -- 1-cent money tolerance
+  v_psp_settled    numeric;
+  v_psp_pending    numeric;
+  v_ledger_dep     numeric;
+  v_onchain        numeric;
+  v_manual         numeric;
+  v_inbound        numeric;
+  v_diff           numeric;
+  v_dup_idem       jsonb;
+  v_dup_psp        jsonb;
+  v_dup_tx         jsonb;
+  v_psp_uncredited jsonb;
+  v_orphan         jsonb;
+  v_legs           jsonb;
+  v_exc_count      int;
+begin
+  if auth.uid() is null or not public.has_role(auth.uid(), 'admin') then
+    raise exception 'Forbidden';
+  end if;
+
+  -- ---- Leg totals (real tables; empty legs report zero, never fabricated) --------
+  select
+    coalesce(sum(amount) filter (where credited_at is not null
+             or coalesce(status,'') ~* '(credit|paid|captur|success|complete|settle)'), 0),
+    coalesce(sum(amount) filter (where credited_at is null
+             and not (coalesce(status,'') ~* '(credit|paid|captur|success|complete|settle)')
+             and not (coalesce(status,'') ~* '(fail|declin|cancel|refund|void|error)')), 0)
+  into v_psp_settled, v_psp_pending
+  from fiat_topups;
+
+  select coalesce(sum(amount), 0) into v_ledger_dep
+  from casino_transactions where type = 'deposit';
+
+  select
+    coalesce((select sum(amount) from crypto_deposits
+              where credited_at is not null or coalesce(status,'') ~* '(credit|confirm|complete|success)'), 0)
+  + coalesce((select sum(amount) from blockchain_deposits where credited is true), 0)
+  + coalesce((select sum(amount) from incoming_deposits  where coalesce(status,'') ~* 'credit'), 0)
+  into v_onchain;
+
+  select coalesce(sum(amount) filter (where coalesce(status,'') ~* '(approv|credit|complete|success|paid)'), 0)
+  into v_manual
+  from deposit_requests;
+
+  v_inbound := round(v_psp_settled + v_onchain + v_manual, 2);
+  v_diff    := round(v_inbound - v_ledger_dep, 2);
+
+  -- ---- Exceptions ---------------------------------------------------------------
+  -- R5: duplicate ledger idempotency key (double credit)
+  select coalesce(jsonb_agg(jsonb_build_object('idempotency_key', k, 'count', c) order by c desc), '[]'::jsonb)
+  into v_dup_idem
+  from (select idempotency_key k, count(*) c from casino_transactions
+        where idempotency_key is not null group by 1 having count(*) > 1 limit 50) q;
+
+  -- R5: duplicate PSP provider_payment_id
+  select coalesce(jsonb_agg(jsonb_build_object('provider_payment_id', k, 'count', c) order by c desc), '[]'::jsonb)
+  into v_dup_psp
+  from (select provider_payment_id k, count(*) c from fiat_topups
+        where provider_payment_id is not null group by 1 having count(*) > 1 limit 50) q;
+
+  -- R5: duplicate on-chain tx_hash across the movement tables
+  select coalesce(jsonb_agg(jsonb_build_object('tx_hash', k, 'count', c) order by c desc), '[]'::jsonb)
+  into v_dup_tx
+  from (
+    select tx_hash k, count(*) c from (
+      select tx_hash from crypto_deposits     where tx_hash is not null
+      union all select tx_hash from blockchain_deposits where tx_hash is not null
+      union all select tx_hash from incoming_deposits   where tx_hash is not null
+    ) u group by 1 having count(*) > 1 limit 50
+  ) q;
+
+  -- R4: PSP line settled but not credited (money arrived, credit not booked)
+  select coalesce(jsonb_agg(jsonb_build_object(
+           'id', id, 'amount', round(amount,2), 'provider_payment_id', provider_payment_id,
+           'status', status) order by created_at desc), '[]'::jsonb)
+  into v_psp_uncredited
+  from fiat_topups
+  where credited_at is null
+    and coalesce(status,'') ~* '(credit|paid|captur|success|complete|settle)'
+  limit 50;
+
+  -- R3: ledger deposit credit whose reference_id ties to no known inbound source
+  select coalesce(jsonb_agg(jsonb_build_object(
+           'tx_id', id, 'amount', round(amount,2), 'reference_id', reference_id,
+           'created_at', created_at) order by created_at desc), '[]'::jsonb)
+  into v_orphan
+  from casino_transactions ct
+  where ct.type = 'deposit'
+    and (
+      ct.reference_id is null
+      or not (
+        exists (select 1 from fiat_topups        f where f.id = ct.reference_id)
+        or exists (select 1 from crypto_deposits     d where d.id = ct.reference_id)
+        or exists (select 1 from blockchain_deposits b where b.id = ct.reference_id)
+        or exists (select 1 from incoming_deposits   i where i.id = ct.reference_id)
+        or exists (select 1 from deposit_requests    r where r.id = ct.reference_id)
+      )
+    )
+  limit 50;
+
+  v_exc_count :=
+      jsonb_array_length(v_dup_idem) + jsonb_array_length(v_dup_psp)
+    + jsonb_array_length(v_dup_tx)   + jsonb_array_length(v_psp_uncredited)
+    + jsonb_array_length(v_orphan);
+
+  -- ---- Leg summaries ------------------------------------------------------------
+  select jsonb_build_object(
+    'psp', jsonb_build_object(
+      'source', 'fiat_topups',
+      'settled_count', (select count(*) from fiat_topups
+                        where credited_at is not null or coalesce(status,'') ~* '(credit|paid|captur|success|complete|settle)'),
+      'settled_total', round(v_psp_settled,2),
+      'pending_total', round(v_psp_pending,2),
+      'rows_total',    (select count(*) from fiat_topups),
+      'note', case when (select count(*) from fiat_topups)=0
+                   then 'No gateway settlements ingested yet' else null end),
+    'ledger', jsonb_build_object(
+      'source', 'casino_transactions(type=deposit)',
+      'credit_count', (select count(*) from casino_transactions where type='deposit'),
+      'credit_total', round(v_ledger_dep,2)),
+    'onchain', jsonb_build_object(
+      'source', 'crypto_deposits + blockchain_deposits + incoming_deposits',
+      'credited_total', round(v_onchain,2),
+      'credited_count',
+        (select count(*) from crypto_deposits where credited_at is not null or coalesce(status,'') ~* '(credit|confirm|complete|success)')
+      + (select count(*) from blockchain_deposits where credited is true)
+      + (select count(*) from incoming_deposits where coalesce(status,'') ~* 'credit')),
+    'manual', jsonb_build_object(
+      'source', 'deposit_requests',
+      'approved_total', round(v_manual,2),
+      'approved_count', (select count(*) from deposit_requests where coalesce(status,'') ~* '(approv|credit|complete|success|paid)'),
+      'failed_count',   (select count(*) from deposit_requests where coalesce(status,'') ~* '(fail|declin|cancel|reject|void|error)'))
+  ) into v_legs;
+
+  return jsonb_build_object(
+    'generated_at', now(),
+    'contract', 'Read-only three-way reconciliation. Credits/corrects nothing; every exception is worked by a human under dual control. Empty legs report zero, never a fabricated settlement.',
+    'legs', v_legs,
+    'three_way', jsonb_build_object(
+      'psp_settled_total',    round(v_psp_settled,2),
+      'onchain_credited_total', round(v_onchain,2),
+      'manual_approved_total',  round(v_manual,2),
+      'inbound_sources_total',  v_inbound,
+      'ledger_deposit_total',   round(v_ledger_dep,2),
+      'difference',             v_diff,
+      'agree',                  (abs(v_diff) <= v_tol)),
+    'exceptions', jsonb_build_object(
+      'duplicate_ledger_idempotency', v_dup_idem,
+      'duplicate_psp_payment_id',     v_dup_psp,
+      'duplicate_onchain_txhash',     v_dup_tx,
+      'psp_settled_uncredited',       v_psp_uncredited,
+      'orphan_ledger_deposit',        v_orphan),
+    'exception_count', v_exc_count,
+    'reconciled_clean', (v_exc_count = 0 and abs(v_diff) <= v_tol)
+  );
+end;
+$$;
+
+revoke all on function public.admin_reconciliation_overview() from public;
+grant execute on function public.admin_reconciliation_overview() to authenticated;
+
+commit;
-- 
