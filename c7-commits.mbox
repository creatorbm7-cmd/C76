+import { cookies } from "next/headers";
+import { redirect } from "next/navigation";
+import { createClient } from "@/utils/supabase/server";
+import { signout } from "../auth/actions";
+
+// Server-side guard: unauthenticated users are redirected to /login.
+// (The middleware refreshes the session; this page enforces access.)
+export default async function ProtectedPage() {
+  const supabase = createClient(await cookies());
+  const {
+    data: { user },
+  } = await supabase.auth.getUser();
+
+  if (!user) {
+    redirect("/login");
+  }
+
+  return (
+    <main style={{ maxWidth: 560, margin: "48px auto", padding: 24 }}>
+      <h1>Protected page</h1>
+      <p>
+        You are signed in as <b>{user.email ?? user.id}</b>. This page is only reachable with an
+        active session.
+      </p>
+      <form action={signout}>
+        <button
+          style={{
+            marginTop: 12, padding: "9px 14px", borderRadius: 8, border: "none",
+            cursor: "pointer", fontWeight: 700, background: "#ff6b7d", color: "#2a0710",
+          }}
+        >
+          Sign out
+        </button>
+      </form>
+    </main>
+  );
+}
